---
interface Props {
  href?: string;
  variant?: 'accent' | 'dark' | 'outline' | 'white' | 'whatsapp';
  target?: string;
  class?: string;
  id?: string;
  hidden?: boolean;
}

const { href, variant = 'accent', target, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener' : undefined}
  class:list={['jf-btn', `jf-btn-${variant}`, className]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .jf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    font: 800 15px/1 var(--font-body);
    letter-spacing: .02em;
    text-transform: uppercase;
    padding: 0 22px;
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
  }
  .jf-btn:active { transform: translateY(1px); }
  .jf-btn[hidden] { display: none; }
  .jf-btn-accent, .jf-btn-whatsapp { background: var(--accent); color: var(--on-accent); }
  .jf-btn-accent:hover, .jf-btn-whatsapp:hover { background: color-mix(in srgb, var(--accent) 86%, var(--text-primary)); color: var(--on-accent); }

  .jf-btn-dark { background: var(--asphalt-900); color: var(--posca-white); border-color: var(--asphalt-900); }
  .jf-btn-dark:hover { background: var(--glass-700); color: var(--posca-white); }

  .jf-btn-outline { background: transparent; color: var(--text-primary); border-color: var(--text-primary); }
  .jf-btn-outline:hover { background: var(--text-primary); color: var(--surface-page); }

  .jf-btn-white { background: var(--posca-white); color: var(--asphalt-900); }
  .jf-btn-white:hover { background: var(--concrete-200); color: var(--asphalt-900); }
</style>
