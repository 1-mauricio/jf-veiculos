---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { brl, km as fmtKm } from '../lib/format';

interface Props {
  /** Cards acima da dobra: carregam sem lazy (candidatos a LCP). */
  priority?: boolean;
  vehicle: CollectionEntry<'veiculos'>;
}

const { vehicle, priority = false } = Astro.props;
const v = vehicle.data;
const href = `/veiculos/${vehicle.id}`;

function hashAngle(id: string): number {
  let h = 0;
  for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) % 360;
  return 128 + (h % 8) * 8;
}

const fotos = v.fotos ?? [];
const placeholderAngle = hashAngle(vehicle.id);

/** O eyebrow já mostra a marca; tira a marca do início do nome para não repetir ("Honda · Honda Biz"). */
const marcaRe = new RegExp(
  '^' + v.marca.trim().split('').map((c) => (c === ' ' ? '\\s*' : c.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))).join('') + '\\s+',
  'i',
);
const nomeCurto = v.nome.replace(marcaRe, '') || v.nome;
---

<a href={href} class="jf-card">
  <div
    class="jf-card-photo"
    data-gallery
    data-fotos={JSON.stringify(fotos)}
    data-idx="0"
  >
    {fotos.length > 0 ? (
      <img data-gallery-img src={fotos[0]} alt={v.nome} loading={priority ? undefined : "lazy"} fetchpriority={priority ? "high" : undefined} decoding="async" />
    ) : (
      <span class="jf-card-photo-label jf-hand">foto em breve</span>
    )}
    <div class="jf-card-glass" aria-hidden="true">
      {v.lancamento && <span class="jf-card-shout jf-hand">0 km!</span>}
      <span class="jf-card-price jf-hand jf-write">{v.preco > 0 ? brl(v.preco) : 'consulte'}</span>
    </div>
    <button type="button" class="jf-card-fav" data-fav-btn data-vehicle-id={vehicle.id} aria-label={`Favoritar ${v.nome}`}>
      <Icon name="heart" size={18} />
    </button>
    {fotos.length > 1 && (
      <>
        <button type="button" class="jf-card-arrow jf-card-arrow-prev" data-gallery-prev aria-label="Foto anterior">
          <Icon name="chevron-left" size={18} color="currentColor" />
        </button>
        <button type="button" class="jf-card-arrow jf-card-arrow-next" data-gallery-next aria-label="Próxima foto">
          <Icon name="chevron-right" size={18} color="currentColor" />
        </button>
      </>
    )}
  </div>
  <div class="jf-card-body">
    <h3 class="jf-card-title"><span class="jf-card-marca">{v.marca}</span> {nomeCurto}</h3>
    <p class="jf-card-facts jf-num">
      {[`${v.ano}/${v.anoModelo}`, v.km != null ? fmtKm(v.km) : null, v.cambio].filter(Boolean).join(' · ')}
    </p>
    <span class="jf-sr-price">{v.preco > 0 ? brl(v.preco) : 'Preço sob consulta'}</span>
  </div>
</a>

<style>
  .jf-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    cursor: pointer;
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-default);
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .jf-card:hover { color: inherit; border-color: var(--text-primary); }
  .jf-card:hover .jf-card-photo img { transform: scale(1.03); }

  .jf-card-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-glass);
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: pan-y;
    user-select: none;
  }
  .jf-card-photo img {
    width: 100%; height: 100%; object-fit: cover; pointer-events: none;
    transition: transform .5s var(--ease-standard);
  }
  .jf-card-photo-label { font-size: 22px; color: var(--text-on-dark-secondary); transform: rotate(-4deg); }

  /* O "vidro": reflexo leve e escurecimento embaixo para a tinta ler sobre qualquer foto. */
  .jf-card-glass {
    position: absolute; inset: 0; pointer-events: none;
    display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start;
    padding: 14px 16px 12px;
    background:
      linear-gradient(115deg, rgba(255,255,255,.10) 0 18%, transparent 18% 100%),
      linear-gradient(to top, rgba(16,18,20,.78), rgba(16,18,20,0) 55%);
  }
  .jf-card-price {
    font-size: 34px; line-height: 1; color: var(--posca-white);
    transform: rotate(-3deg); transform-origin: left bottom;
    text-shadow: 0 1px 0 rgba(0,0,0,.35);
  }
  .jf-card-shout { font-size: 20px; color: var(--accent-on-dark); transform: rotate(-5deg); margin-bottom: 2px; }

  .jf-card-fav {
    position: absolute; top: 8px; right: 8px; width: 44px; height: 44px;
    border-radius: var(--radius-md); background: var(--surface-overlay); border: none; color: var(--posca-white);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
  }
  .jf-card-fav :global(svg) { fill: none; stroke: currentColor; transition: fill var(--dur-fast) var(--ease-standard); }
  .jf-card-fav.is-active { color: var(--accent-on-dark); }
  .jf-card-fav.is-active :global(svg) { fill: currentColor; }

  .jf-card-arrow {
    position: absolute; top: 50%; translate: 0 -50%; width: 40px; height: 40px;
    border-radius: var(--radius-md); background: var(--surface-overlay); color: var(--posca-white); border: none;
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    opacity: 0; transition: opacity var(--dur-fast) var(--ease-standard);
  }
  .jf-card:hover .jf-card-arrow, .jf-card-arrow:focus-visible { opacity: 1; }
  .jf-card-arrow-prev { left: 8px; }
  .jf-card-arrow-next { right: 8px; }

  .jf-card-body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 4px; }
  .jf-card-title { font: 800 18px/1.2 var(--font-display); font-stretch: 88%; text-transform: uppercase; letter-spacing: .01em; margin: 0; color: var(--text-primary); }
  .jf-card-marca { color: var(--text-secondary); font-weight: 700; }
  .jf-card-facts { margin: 0; font: 500 14px var(--font-body); color: var(--text-secondary); }
  .jf-sr-price { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) { .jf-card:hover .jf-card-photo img { transform: none; } }
</style>
