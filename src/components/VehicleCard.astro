---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { brl, km as fmtKm } from '../lib/format';
import { img, srcset } from '../lib/img';

interface Props {
  /** Cards acima da dobra: carregam sem lazy (candidatos a LCP). */
  priority?: boolean;
  /** Nível do título do card; use 2 quando a página não tem h2 antes da lista. */
  headingLevel?: 2 | 3;
  vehicle: CollectionEntry<'veiculos'>;
}

const { vehicle, priority = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const v = vehicle.data;
const href = `/veiculos/${vehicle.id}`;
const foto = v.fotos?.[0];
const nome = v.nome.toLowerCase().startsWith(v.marca.trim().toLowerCase()) ? v.nome : `${v.marca.trim()} ${v.nome}`;
const dados = [v.ano === v.anoModelo ? v.ano : `${v.ano}/${v.anoModelo}`, v.km != null ? fmtKm(v.km) : null, v.cor]
  .filter(Boolean)
  .join(' · ');
---

<article class="jf-card">
  <div class="jf-card-photo">
    {foto ? (
      <img
        src={img(foto, 600)}
        srcset={srcset(foto, [400, 600, 800])}
        sizes="(min-width: 1100px) 400px, (min-width: 620px) 50vw, 100vw"
        width="800"
        height="600"
        alt=""
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      <span class="jf-card-photo-label">Sem foto</span>
    )}
  </div>
  <div class="jf-card-body">
    <Heading class="jf-card-title"><a href={href}>{nome}</a></Heading>
    <p class="jf-card-data">{dados}</p>
    <p class="jf-card-price">{v.preco > 0 ? brl(v.preco) : 'Consulte'}</p>
    <p class="jf-card-cta">Ver fotos e detalhes <span aria-hidden="true">→</span></p>
  </div>
  <button type="button" class="jf-card-fav" data-fav-btn data-vehicle-id={vehicle.id} aria-pressed="false" aria-label={`Favoritar ${nome}`}>
    <Icon name="heart" size={20} />
  </button>
</article>

<style>
  .jf-card {
    position: relative; display: flex; flex-direction: column; height: 100%; color: inherit; background: var(--surface-card);
    border: 1px solid var(--border-default); border-radius: var(--radius-md); overflow: hidden;
    transition: border-color 150ms var(--ease-standard);
  }
  .jf-card:hover, .jf-card:focus-within { border-color: var(--border-strong); }
  .jf-card-photo {
    aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center;
    background: var(--surface-muted); overflow: hidden;
  }
  .jf-card-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 72%; }
  .jf-card-photo-label { font-size: 14px; color: var(--text-secondary); }
  .jf-card-body { padding: 16px 16px 18px; display: flex; flex-direction: column; flex: 1; }
  .jf-card-title { font: 700 24px/1.15 var(--font-display); margin: 0; }
  .jf-card-title a { color: var(--text-primary); text-decoration: none; }
  .jf-card-title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .jf-card-title a:focus-visible { outline: none; }
  .jf-card-title a:focus-visible::after { outline: 2px solid var(--accent); outline-offset: -2px; }
  .jf-card:hover .jf-card-title a, .jf-card:focus-within .jf-card-title a { text-decoration: underline; text-underline-offset: 3px; }
  .jf-card-data { font-size: 14px; color: var(--text-secondary); margin: 4px 0 0; }
  .jf-card-price { font: 700 32px/1.1 var(--font-display); color: var(--text-primary); font-variant-numeric: tabular-nums; margin: auto 0 0; padding-top: 12px; }
  .jf-card-cta { font-size: 14px; font-weight: 600; color: var(--text-secondary); margin: 6px 0 0; transition: color 150ms var(--ease-standard); }
  .jf-card:hover .jf-card-cta, .jf-card:focus-within .jf-card-cta { color: var(--text-primary); }
  .jf-card-fav {
    position: absolute; top: 8px; right: 8px; z-index: 1; width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-md); cursor: pointer;
    transition: border-color 150ms var(--ease-standard);
  }
  .jf-card-fav:hover { border-color: var(--border-strong); }
  .jf-card-fav :global(svg) { fill: none; stroke: var(--text-secondary); }
  .jf-card-fav.is-active :global(svg) { fill: var(--accent); stroke: var(--accent); }
</style>
