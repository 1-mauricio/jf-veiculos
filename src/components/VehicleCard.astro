---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { brl, km as fmtKm } from '../lib/format';

interface Props {
  /** Cards acima da dobra: carregam sem lazy (candidatos a LCP). */
  priority?: boolean;
  vehicle: CollectionEntry<'veiculos'>;
}

const { vehicle, priority = false } = Astro.props;
const v = vehicle.data;
const href = `/veiculos/${vehicle.id}`;

function hashAngle(id: string): number {
  let h = 0;
  for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) % 360;
  return 128 + (h % 8) * 8;
}

const fotos = v.fotos ?? [];
const placeholderAngle = hashAngle(vehicle.id);

/** O eyebrow já mostra a marca; tira a marca do início do nome para não repetir ("Honda · Honda Biz"). */
const marcaRe = new RegExp(
  '^' + v.marca.trim().split('').map((c) => (c === ' ' ? '\\s*' : c.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))).join('') + '\\s+',
  'i',
);
const nomeCurto = v.nome.replace(marcaRe, '') || v.nome;
---

<a href={href} class="jf-card">
  <div
    class="jf-card-photo"
    data-gallery
    data-fotos={JSON.stringify(fotos)}
    data-idx="0"
    style={fotos.length === 0 ? `background: repeating-linear-gradient(${placeholderAngle}deg, var(--surface-muted) 0 15px, var(--border-default) 15px 30px);` : undefined}
  >
    {fotos.length > 0 ? (
      <img data-gallery-img src={fotos[0]} alt={v.nome} loading={priority ? undefined : "lazy"} fetchpriority={priority ? "high" : undefined} decoding="async" />
    ) : (
      <span class="jf-card-photo-label">SEM FOTO</span>
    )}
    <div class="jf-card-badges">
      {v.lancamento && <span class="jf-badge jf-badge-dark">NOVO</span>}
    </div>
    <button type="button" class="jf-card-fav" data-fav-btn data-vehicle-id={vehicle.id} aria-label="Favoritar veículo">
      <Icon name="heart" size={16} />
    </button>
    {fotos.length > 1 && (
      <>
        <button type="button" class="jf-card-arrow jf-card-arrow-prev" data-gallery-prev aria-label="Foto anterior">
          <Icon name="chevron-left" size={18} color="var(--text-primary)" />
        </button>
        <button type="button" class="jf-card-arrow jf-card-arrow-next" data-gallery-next aria-label="Próxima foto">
          <Icon name="chevron-right" size={18} color="var(--text-primary)" />
        </button>
      </>
    )}
  </div>
  <div class="jf-card-body">
    <div>
      <span class="jf-card-eyebrow">{v.categoria ? `${v.marca} · ${v.categoria}` : v.marca}</span>
      <h3 class="jf-card-title">{nomeCurto}</h3>
    </div>
    <div class="jf-card-chips">
      <span class="jf-chip">{v.ano}/{v.anoModelo}</span>
      <span class="jf-chip">{v.km != null ? fmtKm(v.km) : '—'}</span>
      <span class="jf-chip">{v.cambio}</span>
      <span class="jf-chip">{v.combustivel}</span>
    </div>
    <div class="jf-card-price-wrap">
      <div class="jf-card-price">{v.preco > 0 ? brl(v.preco) : 'Consulte'}</div>
    </div>
  </div>
</a>

<style>
  .jf-card {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    color: inherit;
    transition: box-shadow var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
  }
  .jf-card:hover { box-shadow: var(--shadow-raised); }

  .jf-card-photo {
    position: relative;
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--surface-muted);
    touch-action: pan-y;
    user-select: none;
  }
  .jf-card-photo img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }

  .jf-card-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); width: 40px; height: 40px;
    border-radius: var(--radius-full); background: var(--surface-overlay); border: none;
    display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow-card);
    opacity: 0; transition: opacity var(--dur-fast) var(--ease-standard);
  }
  /* Setas só aparecem ao passar o mouse ou focar com o teclado, para não poluir a grade. */
  .jf-card:hover .jf-card-arrow, .jf-card-arrow:focus-visible { opacity: 1; }
  .jf-card-arrow-prev { left: 8px; }
  .jf-card-arrow-next { right: 8px; }
  .jf-card-photo-label { font: 600 11px var(--font-display); letter-spacing: 2px; color: var(--text-secondary); }

  .jf-card-badges { position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; }

  .jf-card-fav {
    position: absolute; top: 10px; right: 10px; width: 40px; height: 40px;
    border-radius: var(--radius-full); background: var(--surface-overlay); border: none;
    display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow-card);
  }
  .jf-card-fav :global(svg) { fill: none; stroke: var(--text-tertiary); transition: fill var(--dur-fast) var(--ease-standard), stroke var(--dur-fast) var(--ease-standard); }
  .jf-card-fav.is-active :global(svg) { fill: var(--accent); stroke: var(--accent); }
  .jf-badge { font-size: 10.5px; font-weight: 700; padding: 4px 9px; border-radius: var(--radius-full); letter-spacing: .3px; color: var(--white); }
  .jf-badge-accent { background: var(--accent); }
  .jf-badge-dark { background: var(--black-900); }

  .jf-card-body {
    padding: 16px 17px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .jf-card-eyebrow { font: var(--text-caption); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: .4px; }
  .jf-card-title { font: 700 18px var(--font-display); margin: 5px 0 0; letter-spacing: -.2px; color: var(--text-primary); }
  .jf-card-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .jf-chip { font-size: 12px; color: var(--text-secondary); background: var(--surface-muted); padding: 4px 9px; border-radius: var(--radius-md); }
  .jf-card-price-wrap { margin-top: auto; padding-top: 6px; border-top: 1px solid var(--border-default); }
  .jf-card-price { font: 700 22px var(--font-display); color: var(--text-primary); letter-spacing: -.3px; margin-top: 10px; }
  /* Mobile: card horizontal (foto à esquerda), como no design. */
  @media (max-width: 620px) {
    .jf-card { flex-direction: row; }
    .jf-card-photo { height: auto; width: 128px; min-height: 168px; flex-shrink: 0; }
    .jf-card-photo-label { font-size: 9px; letter-spacing: 1px; text-align: center; padding: 0 8px; }
    .jf-card-photo img { position: absolute; inset: 0; object-fit: cover; }
    .jf-card-arrow { display: none; }
    .jf-card-body { padding: 12px 14px; gap: 8px; min-width: 0; }
    .jf-card-title { font-size: 16px; }
    .jf-chip:nth-child(n+3) { display: none; }
    .jf-card-price { font-size: 19px; margin-top: 6px; }
  }
  .jf-card-sub { font-size: 12.5px; font-weight: 600; color: var(--text-secondary); margin-top: 2px; }
</style>
