---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/format';

const lojaEntries = await getCollection('loja');
const loja = lojaEntries[0]?.data;
const siteEntries = await getCollection('site');
const site = siteEntries[0]?.data;
const veiculos = await getCollection('veiculos');
const temCarros = veiculos.some((v) => v.data.tipo === 'carro');
const anunciarHref = loja
  ? whatsappLink(loja.whatsapp, `Olá! Quero anunciar meu veículo na ${site?.nomeSite ?? 'JF Veículos'}.`)
  : '/loja';
---

<header class="jf-header">
  <div class="jf-header-inner">
    <a href="/" class="jf-brand">
      <Logo size={40} />
      <div class="jf-brand-text">
        <div class="jf-brand-name">{site?.nomeSite ?? 'JF Veículos'}</div>
        <div class="jf-brand-tag">{site?.tagline ?? 'seu seminovo de confiança'}</div>
      </div>
    </a>

    <nav class="jf-nav">
      {temCarros && <a href="/veiculos?tipo=carro" class="jf-nav-link">Carros</a>}
      <a href="/veiculos?tipo=moto" class="jf-nav-link">Motos</a>
      <a href="/veiculos" class="jf-nav-link">Estoque</a>
      <a href="/loja" class="jf-nav-link">Nossa loja</a>
    </nav>

    <div class="jf-header-actions">
      <button type="button" class="jf-icon-btn" data-theme-toggle aria-label="Mudar para tema escuro" title="Mudar para tema escuro">
        <span class="jf-theme-moon"><Icon name="moon" size={20} /></span>
        <span class="jf-theme-sun"><Icon name="sun" size={20} /></span>
      </button>
      <a href="/favoritos" class="jf-fav-nav jf-icon-btn" data-fav-nav aria-label="Meus favoritos">
        <Icon name="heart" size={19} />
        <span class="jf-fav-count" data-fav-count>0</span>
      </a>
      <a href={anunciarHref} target="_blank" rel="noopener" class="jf-btn-sell" data-wa-track="header_anunciar">Vender o meu</a>
      <button type="button" id="jf-menu-toggle" class="jf-menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="jf-mobile-nav">
        <span class="jf-menu-toggle-icon-open"><Icon name="menu" size={22} /></span>
        <span class="jf-menu-toggle-icon-close"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </div>

  <nav id="jf-mobile-nav" class="jf-mobile-nav">
    {temCarros && <a href="/veiculos?tipo=carro" class="jf-mobile-nav-link">Carros</a>}
    <a href="/veiculos?tipo=moto" class="jf-mobile-nav-link">Motos</a>
    <a href="/veiculos" class="jf-mobile-nav-link">Estoque</a>
    <a href="/loja" class="jf-mobile-nav-link">Nossa loja</a>
  </nav>
</header>

<style>
  .jf-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface-header);
    color: var(--posca-white);
    border-bottom: 3px solid var(--accent);
  }
  .jf-header-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 10px 24px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .jf-brand { display: flex; align-items: center; gap: 12px; flex-shrink: 0; color: var(--posca-white); }
  .jf-brand:hover { color: var(--posca-white); }
  .jf-brand-text { line-height: 1; }
  .jf-brand-name { font: 800 19px var(--font-display); font-stretch: 85%; text-transform: uppercase; letter-spacing: .01em; }
  /* A tagline já é o título da vitrine; no cabeçalho ela só repetiria. */
  .jf-brand-tag { display: none; }

  .jf-nav { display: flex; gap: 2px; margin-left: 8px; }
  .jf-nav-link {
    padding: 10px 14px;
    font: 700 14px var(--font-body);
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--text-on-dark-secondary);
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
  }
  .jf-nav-link:hover { color: var(--posca-white); border-bottom-color: var(--accent-on-dark); }

  .jf-header-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }

  .jf-icon-btn {
    position: relative; display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: var(--radius-md); color: var(--text-on-dark-secondary);
    border: none; background: none; cursor: pointer; padding: 0;
    transition: background var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard);
  }
  .jf-icon-btn:hover { background: var(--glass-700); color: var(--posca-white); }
  .jf-icon-btn span { display: flex; }
  .jf-theme-sun { display: none !important; }
  :global(:root[data-theme="dark"]) .jf-theme-sun { display: flex !important; }
  :global(:root[data-theme="dark"]) .jf-theme-moon { display: none !important; }
  .jf-fav-nav :global(svg) { fill: none; stroke: currentColor; }
  .jf-fav-nav.has-favs :global(svg) { fill: var(--accent-on-dark); stroke: var(--accent-on-dark); }
  .jf-fav-count {
    position: absolute; top: 2px; right: 2px; min-width: 17px; height: 17px; padding: 0 4px;
    border-radius: var(--radius-sm); background: var(--accent); color: var(--on-accent);
    font: 800 10.5px/1 var(--font-body); display: flex; align-items: center; justify-content: center;
  }
  .jf-fav-nav:not(.has-favs) .jf-fav-count { display: none; }
  .jf-btn-sell {
    min-height: 44px; display: inline-flex; align-items: center;
    padding: 0 16px;
    border-radius: var(--radius-md);
    border: 2px solid var(--glass-500);
    color: var(--posca-white);
    font: 800 13px var(--font-body);
    letter-spacing: .04em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .jf-btn-sell:hover { border-color: var(--accent-on-dark); color: var(--posca-white); }

  .jf-menu-toggle {
    display: none; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: var(--radius-md); border: none; background: none;
    color: var(--posca-white); cursor: pointer; flex-shrink: 0;
  }
  .jf-menu-toggle:hover { background: var(--glass-700); }
  .jf-menu-toggle-icon-close { display: none; }

  .jf-mobile-nav { display: none; }

  @media (max-width: 980px) {
    .jf-nav { display: none; }
    .jf-menu-toggle { display: flex; }
    .jf-header.is-menu-open .jf-menu-toggle-icon-open { display: none; }
    .jf-header.is-menu-open .jf-menu-toggle-icon-close { display: block; }

    .jf-mobile-nav {
      display: flex; flex-direction: column;
      /* interpolate-size anima até a altura natural; visibility tira os links do Tab quando fechado. */
      interpolate-size: allow-keywords;
      height: 0; overflow: hidden; padding: 0 16px; visibility: hidden;
      transition-property: height, padding, visibility;
      transition-duration: var(--dur-base);
      transition-timing-function: var(--ease-standard);
      transition-behavior: allow-discrete;
    }
    .jf-header.is-menu-open .jf-mobile-nav { height: auto; padding: 4px 16px 16px; visibility: visible; }
    .jf-mobile-nav-link {
      padding: 14px 4px; border-bottom: 1px solid var(--glass-700);
      font: 800 17px var(--font-body); letter-spacing: .03em; text-transform: uppercase; color: var(--posca-white);
    }
    .jf-mobile-nav-link:hover { color: var(--accent-on-dark); }
  }
  @media (max-width: 620px) {
    .jf-header-inner { gap: 8px; padding: 8px 12px 8px 16px; }
    .jf-brand { gap: 10px; min-width: 0; }
    .jf-brand-text { min-width: 0; }
    .jf-brand-name { font-size: 17px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .jf-brand-tag { display: none; }
    .jf-btn-sell { display: none; }
    .jf-header-actions { gap: 2px; flex-shrink: 0; }
  }
</style>
