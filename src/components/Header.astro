---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/format';

const lojaEntries = await getCollection('loja');
const loja = lojaEntries[0]?.data;
const siteEntries = await getCollection('site');
const site = siteEntries[0]?.data;
const anunciarHref = loja
  ? whatsappLink(loja.whatsapp, `Olá! Quero anunciar meu veículo na ${site?.nomeSite ?? 'JF Veículos'}.`)
  : '/loja';
---

<header class="jf-header">
  <div class="jf-header-inner">
    <a href="/" class="jf-brand">
      <Logo size={40} />
      <div class="jf-brand-text">
        <div class="jf-brand-name">{site?.nomeSite ?? 'JF Veículos'}</div>
        <div class="jf-brand-tag">{site?.tagline ?? 'seu seminovo de confiança'}</div>
      </div>
    </a>

    <nav class="jf-nav">
      <a href="/veiculos?tipo=carro" class="jf-nav-link">Carros</a>
      <a href="/veiculos?tipo=moto" class="jf-nav-link">Motos</a>
      <a href="/veiculos" class="jf-nav-link">Estoque</a>
      <a href="/loja" class="jf-nav-link">Nossa loja</a>
    </nav>

    <div class="jf-header-actions">
      <a href="/favoritos" class="jf-fav-nav" data-fav-nav aria-label="Meus favoritos">
        <Icon name="heart" size={19} />
        <span class="jf-fav-count" data-fav-count>0</span>
      </a>
      <a href={anunciarHref} target="_blank" rel="noopener" class="jf-btn-accent">Anunciar</a>
    </div>
  </div>
</header>

<style>
  .jf-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, .88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-default);
  }
  .jf-header-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .jf-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    flex-shrink: 0;
  }
  .jf-brand-mark {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 19px var(--font-display);
    color: var(--white);
    letter-spacing: -1px;
  }
  .jf-brand-text { line-height: 1; }
  .jf-brand-name { font: 700 18px var(--font-display); letter-spacing: -.3px; color: var(--text-primary); }
  .jf-brand-tag { font-size: 10.5px; letter-spacing: 1.5px; color: var(--text-tertiary); text-transform: uppercase; margin-top: 3px; }

  .jf-nav { display: flex; gap: 4px; margin-left: 8px; }
  .jf-nav-link {
    padding: 9px 14px;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 14.5px;
    color: var(--text-secondary);
    transition: background var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard);
  }
  .jf-nav-link:hover { background: var(--gray-100); color: var(--text-primary); }

  .jf-header-actions { margin-left: auto; display: flex; align-items: center; gap: 12px; }

  .jf-fav-nav {
    position: relative; display: flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: var(--radius-full); color: var(--text-secondary);
    transition: background var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard);
  }
  .jf-fav-nav:hover { background: var(--gray-100); color: var(--text-primary); }
  .jf-fav-nav :global(svg) { fill: none; stroke: currentColor; }
  .jf-fav-nav.has-favs :global(svg) { fill: var(--accent); stroke: var(--accent); }
  .jf-fav-count {
    position: absolute; top: -2px; right: -2px; min-width: 16px; height: 16px; padding: 0 3px;
    border-radius: var(--radius-full); background: var(--accent); color: var(--white);
    font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center;
  }
  .jf-fav-nav:not(.has-favs) .jf-fav-count { display: none; }
  .jf-btn-accent {
    padding: 10px 20px;
    border-radius: var(--radius-full);
    border: none;
    background: var(--accent);
    color: var(--white);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: background var(--dur-base) var(--ease-standard);
  }
  .jf-btn-accent:hover { background: var(--accent-strong); color: var(--white); }

  @media (max-width: 980px) {
    .jf-nav { display: none; }
  }
  @media (max-width: 620px) {
    .jf-header-inner { gap: 8px; padding: 12px 16px; }
    .jf-brand { gap: 8px; min-width: 0; }
    .jf-brand-text { min-width: 0; }
    .jf-brand-name { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .jf-brand-tag { display: none; }
    .jf-header-actions { gap: 8px; flex-shrink: 0; }
    .jf-btn-accent { padding: 9px 14px; font-size: 13px; }
  }
</style>
