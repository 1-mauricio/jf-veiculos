---
import { getCollection } from 'astro:content';

interface Props {
  size?: number;
}

const { size = 34 } = Astro.props;

const siteEntries = await getCollection('site');
const nomeSite = siteEntries[0]?.data.nomeSite ?? 'JF Veículos';
---

<img
  src="/images/site/logo-linha.png"
  alt={nomeSite}
  height={size}
  width={Math.round(size * 1044 / 150)}
  style={`height:${size}px;width:auto;flex-shrink:0;`}
/>
