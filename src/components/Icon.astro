---
interface Props {
  name: 'search' | 'car' | 'gauge' | 'check' | 'star' | 'cart' | 'shield' | 'heart' | 'chevron-left' | 'chevron-right' | 'instagram' | 'menu' | 'x';
  size?: number;
  color?: string;
}

const { name, size = 20, color = 'currentColor' } = Astro.props;

const paths: Record<Props['name'], string> = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  car: '<path d="M5 17h14l1.4-5.6a2 2 0 0 0-1.94-2.4H4.54A2 2 0 0 0 2.6 11.4L4 17z"/><path d="M5 17v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2"/><path d="M16 17v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2"/><path d="M6 9h12l-1.5-4.5A2 2 0 0 0 14.6 3H9.4a2 2 0 0 0-1.9 1.5z"/>',
  gauge: '<path d="M12 14 15 9"/><circle cx="12" cy="14" r="1"/><path d="M4.6 19a9 9 0 1 1 14.8 0"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  star: '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21.1 7 14.2 2 9.3l6.9-1z"/>',
  cart: '<circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.5 3h2l2.6 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6"/>',
  shield: '<path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5z"/>',
  heart: '<path d="M12 20.5s-7.5-4.6-9.8-9.3A5 5 0 0 1 12 6a5 5 0 0 1 9.8 5.2C19.5 15.9 12 20.5 12 20.5z"/>',
  'chevron-left': '<path d="m14.5 5-7 7 7 7"/>',
  'chevron-right': '<path d="m9.5 5 7 7-7 7"/>',
  instagram: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  menu: '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>',
  x: '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
