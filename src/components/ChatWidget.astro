---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const lojaEntries = await getCollection('loja');
const waNumber = lojaEntries[0]?.data.whatsapp ?? '';
---

<div class="jf-chat" data-chat-panel data-wa-number={waNumber}>
  <button type="button" class="jf-chat-toggle" data-chat-toggle aria-label="Abrir chat">
    <Icon name="whatsapp" size={24} color="var(--white)" />
  </button>

  <div class="jf-chat-window">
    <div class="jf-chat-header">
      <span>Fale com a JF Veículos</span>
      <button type="button" class="jf-chat-close" data-chat-close aria-label="Fechar chat">
        <Icon name="x" size={18} />
      </button>
    </div>

    <div class="jf-chat-log" data-chat-log></div>

    <form class="jf-chat-form" data-chat-form>
      <input
        type="text"
        name="message"
        placeholder="Digite sua mensagem..."
        autocomplete="off"
        data-chat-input
      />
      <button type="submit" aria-label="Enviar">
        <Icon name="chevron-right" size={18} color="var(--white)" />
      </button>
    </form>
  </div>
</div>

<script>
  import { initChatWidget } from '../scripts/chat';
  initChatWidget();
</script>

<style>
  .jf-chat {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
  }

  .jf-chat-toggle {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: #25d366;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .jf-chat-toggle:hover { transform: scale(1.05); }
  .jf-chat-toggle.is-open { background: var(--black-800); }

  .jf-chat-window {
    display: none;
    flex-direction: column;
    position: absolute;
    right: 0;
    bottom: 72px;
    width: min(360px, calc(100vw - 40px));
    height: min(520px, calc(100vh - 140px));
    background: var(--surface-card);
    border-radius: 16px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.24);
    overflow: hidden;
    border: 1px solid var(--border-default);
  }
  [data-chat-panel].is-open .jf-chat-window { display: flex; }

  .jf-chat-header {
    background: var(--black-900);
    color: var(--white);
    padding: 14px 16px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .jf-chat-close {
    background: none;
    border: none;
    color: var(--white);
    cursor: pointer;
    display: flex;
    padding: 2px;
  }

  .jf-chat-log {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--surface-sunken);
  }

  .jf-chat-bubble {
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 0.9rem;
    line-height: 1.4;
    white-space: pre-wrap;
  }
  .jf-chat-bubble-assistant {
    align-self: flex-start;
    background: var(--white);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    border-bottom-left-radius: 4px;
  }
  .jf-chat-bubble-user {
    align-self: flex-end;
    background: var(--accent);
    color: var(--white);
    border-bottom-right-radius: 4px;
  }
  .jf-chat-bubble-typing { opacity: 0.6; font-style: italic; }

  .jf-chat-cta { align-self: flex-start; }
  .jf-chat-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #25d366;
    color: var(--white);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 10px 16px;
    border-radius: 999px;
    text-decoration: none;
  }
  .jf-chat-cta-btn:hover { background: #1fb956; }
  .jf-chat-cta-btn-outline {
    background: transparent;
    color: var(--accent-strong);
    border: 1.5px solid var(--accent);
  }
  .jf-chat-cta-btn-outline:hover { background: var(--accent-soft); }

  .jf-chat-form {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid var(--border-default);
    background: var(--white);
  }
  .jf-chat-form input {
    flex: 1;
    border: 1px solid var(--border-default);
    border-radius: 999px;
    padding: 10px 14px;
    font-size: 0.9rem;
    font-family: inherit;
  }
  .jf-chat-form input:focus { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
  .jf-chat-form button {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--accent);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .jf-chat-form button:disabled { opacity: 0.5; cursor: default; }

  @media (max-width: 480px) {
    .jf-chat { right: 12px; bottom: 12px; }
    .jf-chat-window { right: -4px; }
  }
</style>
