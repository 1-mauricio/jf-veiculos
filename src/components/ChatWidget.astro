---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import '../styles/chat-widget.css';

const lojaEntries = await getCollection('loja');
const waNumber = lojaEntries[0]?.data.whatsapp ?? '';
---

<div class="jf-chat" data-chat-panel data-wa-number={waNumber}>
  <button type="button" class="jf-chat-toggle" data-chat-toggle aria-label="Abrir chat">
    <Icon name="whatsapp" size={24} color="var(--white)" />
  </button>

  <div class="jf-chat-window">
    <div class="jf-chat-header">
      <span>Fale com a JF Veículos</span>
      <button type="button" class="jf-chat-close" data-chat-close aria-label="Fechar chat">
        <Icon name="x" size={18} />
      </button>
    </div>

    <div class="jf-chat-log" data-chat-log></div>

    <form class="jf-chat-form" data-chat-form>
      <input
        type="text"
        name="message"
        placeholder="Digite sua mensagem..."
        autocomplete="off"
        data-chat-input
      />
      <button type="submit" aria-label="Enviar">
        <Icon name="chevron-right" size={18} color="var(--white)" />
      </button>
    </form>
  </div>
</div>

<script>
  import { initChatWidget } from '../scripts/chat/widget';
  initChatWidget();
</script>
