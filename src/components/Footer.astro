---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { whatsappLink, formatPhone } from '../lib/format';

const lojaEntries = await getCollection('loja');
const loja = lojaEntries[0]?.data;
const siteEntries = await getCollection('site');
const site = siteEntries[0]?.data;
const nomeSite = site?.nomeSite ?? 'JF Veículos';
const whatsappHref = loja ? whatsappLink(loja.whatsapp, `Olá! Vim pelo site da ${nomeSite}.`) : '#';
const instagramHref = loja?.instagram ? `https://instagram.com/${loja.instagram}` : null;
const year = new Date().getFullYear();
---

<footer class="jf-footer">
  <div class="jf-foot">
    <div>
      <div class="jf-foot-brand">
        <Logo size={34} radius="var(--radius-sm)" />
        <span class="jf-foot-name">{nomeSite}</span>
      </div>
      <p class="jf-foot-desc">{site?.footerDescricao}</p>
      {instagramHref && (
        <a href={instagramHref} target="_blank" rel="noopener" class="jf-foot-social" aria-label={`Instagram da ${nomeSite}`}>
          <Icon name="instagram" size={18} />
          <span>@{loja?.instagram}</span>
        </a>
      )}
    </div>
    <div>
      <div class="jf-foot-title">Comprar</div>
      <div class="jf-foot-links">
        <a href="/veiculos?tipo=carro">Carros usados</a>
        <a href="/veiculos?tipo=moto">Motos</a>
        <a href="/veiculos">Ofertas da semana</a>
      </div>
    </div>
    <div>
      <div class="jf-foot-title">Institucional</div>
      <div class="jf-foot-links">
        <a href="/loja">Sobre a loja</a>
      </div>
    </div>
    <div>
      <div class="jf-foot-title">Atendimento</div>
      <div class="jf-foot-links">
        {loja && <span>{loja.horarios}</span>}
        {loja?.whatsapp && <span class="jf-foot-phone">{formatPhone(loja.whatsapp)}</span>}
        <a href={whatsappHref} target="_blank" rel="noopener" class="jf-foot-whatsapp" data-wa-track="footer">WhatsApp</a>
      </div>
    </div>
  </div>
  <div class="jf-foot-bottom-wrap">
    <div class="jf-foot-bottom">
      <span>© {year} {nomeSite}. Todos os direitos reservados. {loja && `CNPJ ${loja.cnpj}.`}</span>
    </div>
  </div>
</footer>

<style>
  .jf-footer {
    border-top: 1px solid var(--black-700);
    background: var(--black-900);
    margin-top: 40px;
  }
  .jf-foot {
    max-width: 1240px;
    margin: 0 auto;
    padding: 52px 24px 30px;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .jf-foot-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
  .jf-foot-name { font: 700 17px var(--font-display); color: var(--white); }
  .jf-foot-desc { color: var(--gray-400); font-size: 14px; line-height: 1.7; max-width: 300px; margin: 0 0 16px; }
  .jf-foot-social {
    display: inline-flex; align-items: center; gap: 8px; color: var(--gray-400); font-size: 14px; font-weight: 600;
  }
  .jf-foot-social:hover { color: var(--white); }
  .jf-foot-title { font: 700 14px var(--font-display); color: var(--white); margin-bottom: 16px; }
  .jf-foot-links { display: flex; flex-direction: column; gap: 11px; font-size: 14px; color: var(--gray-400); }
  .jf-foot-links a { color: var(--gray-400); }
  .jf-foot-links a:hover { color: var(--white); }
  .jf-foot-phone { color: var(--white); font-weight: 700; font-size: 16px; }
  .jf-foot-whatsapp { color: var(--accent-on-dark) !important; font-weight: 700; }

  .jf-foot-bottom-wrap { border-top: 1px solid var(--black-700); }
  .jf-foot-bottom {
    max-width: 1240px; margin: 0 auto; padding: 20px 24px;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    font-size: 12.5px; color: var(--gray-500);
  }

  @media (max-width: 980px) {
    .jf-foot { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .jf-foot { grid-template-columns: 1fr; }
  }
</style>
