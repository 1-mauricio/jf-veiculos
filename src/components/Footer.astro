---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { whatsappLink, formatPhone } from '../lib/format';

const loja = (await getCollection('loja'))[0]?.data;
const nomeSite = (await getCollection('site'))[0]?.data.nomeSite ?? 'JF Veículos';
const temCarros = (await getCollection('veiculos')).some((veiculo) => veiculo.data.tipo === 'carro');
const whatsappHref = loja ? whatsappLink(loja.whatsapp, `Olá! Vim pelo site da ${nomeSite}.`) : '#';
const instagramHref = loja?.instagram ? `https://instagram.com/${loja.instagram}` : null;
const year = new Date().getFullYear();
---

<footer class="jf-footer">
  <div class="jf-foot">
    <div>
      <div class="jf-foot-brand"><Logo size={30} /></div>
      {loja && <address class="jf-foot-contact">
        <span>{loja.endereco}<br />{loja.cidade.trim()} - {loja.uf}</span>
        <span>{loja.horarios}</span>
        <a href={whatsappHref} target="_blank" rel="noopener" data-wa-track="footer">WhatsApp: {formatPhone(loja.whatsapp)}</a>
        {instagramHref && <a href={instagramHref} target="_blank" rel="noopener">Instagram: @{loja.instagram}</a>}
      </address>}
    </div>
    <nav aria-label="Links do rodapé">
      <h2 class="jf-foot-title">Links úteis</h2>
      <div class="jf-foot-links">
        <a href="/veiculos">Estoque</a>
        {temCarros && <a href="/veiculos?tipo=carro">Carros</a>}
        <a href="/loja">Nossa loja</a>
        <a href="/favoritos">Favoritos</a>
      </div>
    </nav>
  </div>
  <div class="jf-foot-bottom-wrap"><div class="jf-foot-bottom">© {year} {nomeSite}. {loja && `CNPJ ${loja.cnpj}.`}</div></div>
</footer>

<style>
  .jf-footer { border-top: 1px solid var(--black-700); background: var(--black-900); margin-top: var(--space-10); }
  .jf-foot { max-width: 1240px; margin: 0 auto; padding: var(--space-12) var(--space-6) var(--space-8); display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-10); }
  .jf-foot-brand { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); }
  .jf-foot-contact, .jf-foot-links { display: flex; flex-direction: column; align-items: flex-start; color: var(--gray-400); font: var(--text-body); }
  .jf-foot-contact { font-style: normal; gap: var(--space-2); }
  .jf-foot a { color: var(--gray-400); display: inline-flex; align-items: center; min-height: 44px; }
  .jf-foot a:hover { color: var(--white); }
  .jf-foot-title { font: var(--text-h3); color: var(--white); margin: 0 0 var(--space-2); }
  .jf-foot-bottom-wrap { border-top: 1px solid var(--black-700); }
  .jf-foot-bottom { max-width: 1240px; margin: 0 auto; padding: var(--space-5) var(--space-6); font: var(--text-small); color: var(--gray-400); }
  @media (max-width: 620px) { .jf-foot { grid-template-columns: 1fr !important; gap: var(--space-8); } }
</style>
