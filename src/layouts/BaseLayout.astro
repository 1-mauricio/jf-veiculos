---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { COLOR_THEMES, FONT_THEMES, DEFAULT_COLOR_THEME, DEFAULT_FONT_THEME } from '../lib/themes';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Carros e motos seminovos com inspeção veicular completa, garantia e financiamento aprovado na hora.',
  image,
} = Astro.props;

const siteEntries = await getCollection('site');
const nomeSite = siteEntries[0]?.data.nomeSite ?? 'JF Veículos';
const fullTitle = title === nomeSite ? title : `${title} · ${nomeSite}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const aparenciaEntries = await getCollection('aparencia');
const aparencia = aparenciaEntries[0]?.data;
const colorTheme = COLOR_THEMES[aparencia?.corTema ?? DEFAULT_COLOR_THEME];
const fontTheme = FONT_THEMES[aparencia?.fonteTema ?? DEFAULT_FONT_THEME];
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="stylesheet" href={fontTheme.googleFontsUrl} />
  <style set:html={`html:root {
    --accent: ${colorTheme.accent};
    --accent-strong: ${colorTheme.accentStrong};
    --accent-soft: ${colorTheme.accentSoft};
    --accent-on-dark: ${colorTheme.accentOnDark};
    --focus-ring: ${colorTheme.accent};
    --font-display: ${fontTheme.display};
    --font-body: ${fontTheme.body};
  }`} />

  <script>
    import { initGalleries } from '../scripts/gallery';
    initGalleries();
  </script>

  <!-- Redireciona para /admin depois que a pessoa confirma o convite/login do painel de edição. -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', (user) => {
        if (!user) {
          window.netlifyIdentity.on('login', () => {
            document.location.href = '/admin/';
          });
        }
      });
    }
  </script>
</head>
<body>
  <div class="jf-page">
    <Header />
    <main class="jf-main">
      <slot />
    </main>
    <Footer />
  </div>
</body>
</html>

<style>
  .jf-page { min-height: 100vh; display: flex; flex-direction: column; }
  .jf-main { flex: 1; }
</style>
