---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import Icon from '../../components/Icon.astro';
import { brl, brlDec, km as fmtKm, whatsappLink, parcela, FINANCIAMENTO } from '../../lib/format';
import { img, srcset } from '../../lib/img';

export async function getStaticPaths() {
  const veiculos = await getCollection('veiculos');
  return veiculos.map((v) => ({ params: { slug: v.id }, props: { vehicleId: v.id } }));
}

const { vehicleId } = Astro.props;
const veiculos = await getCollection('veiculos');
const vehicle = veiculos.find((v) => v.id === vehicleId)!;
const v = vehicle.data;

const lojaEntries = await getCollection('loja');
const loja = lojaEntries[0]?.data;

const fotos = v.fotos ?? [];
const temFotos = fotos.length > 0;
const cidade = v.cidade || 'Recife';
const uf = v.uf || 'PE';

const kmTexto = v.km != null ? fmtKm(v.km) : '—';

const fichas: [string, string][] = v.tipo === 'moto'
  ? [
      ['Marca', v.marca], ['Modelo', v.modelo], ['Ano/Modelo', `${v.ano}/${v.anoModelo}`],
      ['Quilometragem', kmTexto], ['Cilindrada', v.cilindrada || '—'], ['Potência', v.potencia || '—'],
      ['Câmbio', v.cambio], ['Combustível', v.combustivel], ['Cor', v.cor], ['Cidade', `${cidade} · ${uf}`],
    ]
  : [
      ['Marca', v.marca], ['Modelo', v.modelo], ['Ano/Modelo', `${v.ano}/${v.anoModelo}`],
      ['Quilometragem', kmTexto], ['Câmbio', v.cambio], ['Combustível', v.combustivel],
      ['Motor', v.motor || '—'], ['Potência', v.potencia || '—'], ['Portas', v.portas ? `${v.portas} portas` : '—'],
      ['Cor', v.cor], ['Cidade', `${cidade} · ${uf}`],
    ];

const similares = veiculos
  .filter((x) => x.data.tipo === v.tipo && x.id !== vehicle.id)
  .sort((a, b) => Math.abs(a.data.preco - v.preco) - Math.abs(b.data.preco - v.preco))
  .slice(0, 4);
const anoTexto = v.ano === v.anoModelo ? String(v.ano) : `${v.ano}/${v.anoModelo}`;
const dadosLinha = [anoTexto, v.km != null ? kmTexto : null, v.cambio, v.combustivel].filter(Boolean).join(' · ');
const slides = fotos.map((f) => ({ src: img(f, 1200), srcset: srcset(f, [800, 1200, 1600]) }));

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const waHref = (msg: string) => (loja ? whatsappLink(loja.whatsapp, msg) : '#');
const interesseHref = waHref(`Olá! Tenho interesse na ${v.nome} ${v.ano}, anunciada por ${brl(v.preco)}.
${pageUrl}`);
const financiamentoHref = waHref(`Olá! Quero consultar financiamento da ${v.nome} ${v.ano}, anunciada por ${brl(v.preco)}.
${pageUrl}`);

// Simulador de financiamento desativado temporariamente. Para reativar, troque para `true`.
const SHOW_FINANCING_SIMULATOR = false;

const parcelaInicial = parcela(v.preco * (1 - FINANCIAMENTO.entradaPct));

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': v.tipo === 'moto' ? 'Motorcycle' : 'Car',
  name: v.nome,
  brand: v.marca,
  model: v.modelo,
  vehicleModelDate: String(v.ano),
  productionDate: String(v.ano),
  vehicleConfiguration: v.categoria,
  color: v.cor,
  fuelType: v.combustivel,
  vehicleTransmission: v.cambio,
  mileageFromOdometer: v.km != null ? { '@type': 'QuantitativeValue', value: v.km, unitCode: 'KMT' } : undefined,
  image: fotos.map((f) => new URL(f, Astro.site)),
  description: v.descricao,
  offers: {
    '@type': 'Offer',
    price: v.preco,
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
    url: canonicalURL,
    itemCondition: 'https://schema.org/UsedCondition',
    seller: loja ? { '@type': 'AutoDealer', name: 'JF Veículos', telephone: loja.whatsapp } : undefined,
  },
};
---

<BaseLayout title={v.nome} description={v.descricao} image={fotos[0]}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="jf-det-wrap">
    <div class="jf-breadcrumb">
      <a href="/">Início</a> <span>›</span> <a href="/veiculos">Veículos</a> <span>›</span> <span class="jf-breadcrumb-current">{v.nome}</span>
    </div>

    <div class="jf-det">
      <aside class="jf-det-aside">
        <div class="jf-det-head">
          <h1 class="jf-det-title">{v.nome}</h1>
          <p class="jf-det-data">{dadosLinha}</p>
        </div>

        <div class="jf-buy">
          <div class="jf-price-value">{brl(v.preco)}</div>
          <a href={interesseHref} target="_blank" rel="noopener" class="jf-btn jf-btn-wa" data-wa-track="veiculo_detalhe" data-wa-vehicle={v.nome}>Tenho interesse nesta moto</a>
          <a href={financiamentoHref} target="_blank" rel="noopener" class="jf-btn jf-btn-outline" data-wa-track="veiculo_financiamento" data-wa-vehicle={v.nome}>Consultar financiamento</a>
          <button type="button" class="jf-fav-btn" data-fav-btn data-vehicle-id={vehicle.id}>
            <Icon name="heart" size={16} />
            <span data-fav-label>Favoritar</span>
          </button>
        </div>

        <!-- SIMULADOR -->
        {SHOW_FINANCING_SIMULATOR && (
          <div class="jf-sim-card" id="jf-sim" data-preco={v.preco}>
            <h3 class="jf-det-h3">Simule seu financiamento</h3>
            <div class="jf-sim-row">
              <label class="jf-filter-label" for="jf-sim-entrada">Entrada</label>
              <span class="jf-filter-value" id="jf-sim-entrada-pct">20%</span>
            </div>
            <input type="range" id="jf-sim-entrada" min="0" max="50" step="5" value="20" aria-describedby="jf-sim-entrada-pct" />
            <div class="jf-sim-sub">Valor de entrada: <strong id="jf-sim-entrada-valor">{brl(v.preco * 0.2)}</strong></div>

            <div class="jf-sim-row jf-sim-row-top">
              <span class="jf-filter-label" id="jf-parcelas-label">Parcelas</span>
            </div>
            <div class="jf-chips" role="group" aria-labelledby="jf-parcelas-label">
              <button type="button" class="jf-chip-btn" data-parcelas="12">12x</button>
              <button type="button" class="jf-chip-btn" data-parcelas="24">24x</button>
              <button type="button" class="jf-chip-btn" data-parcelas="36">36x</button>
              <button type="button" class="jf-chip-btn is-active" data-parcelas="48">48x</button>
              <button type="button" class="jf-chip-btn" data-parcelas="60">60x</button>
            </div>

            <div class="jf-sim-result">
              <div class="jf-sim-result-row"><span>Parcela estimada</span><strong id="jf-sim-parcela-valor">{brlDec(parcelaInicial)} em 48x</strong></div>
              <div class="jf-sim-result-row"><span>Total financiado</span><strong id="jf-sim-total">{brl(v.preco * 0.2 + parcelaInicial * 48)}</strong></div>
            </div>
            <p class="jf-sim-disclaimer">Simulação estimada (taxa de 1,59% a.m.). Sujeita a análise de crédito.</p>
            <a href={financiamentoHref} target="_blank" rel="noopener" class="jf-sim-cta" data-wa-track="veiculo_simulacao" data-wa-vehicle={v.nome}>Enviar simulação no WhatsApp</a>
          </div>
        )}
      </aside>

      <div class="jf-galeria" data-gallery data-slides={JSON.stringify(slides)}>
        {temFotos ? (
          <>
            <div class="jf-galeria-stage" data-gallery-stage>
              <img
                data-gallery-img
                src={slides[0].src}
                srcset={slides[0].srcset}
                sizes="(min-width: 981px) 62vw, 100vw"
                width="1600" height="1200"
                alt={v.nome}
                fetchpriority="high"
                loading="eager"
                decoding="async"
              />
              {fotos.length > 1 && (
                <>
                  <button type="button" class="jf-galeria-arrow jf-galeria-prev" data-gallery-prev aria-label="Foto anterior">
                    <Icon name="chevron-left" size={20} color="var(--text-primary)" />
                  </button>
                  <button type="button" class="jf-galeria-arrow jf-galeria-next" data-gallery-next aria-label="Próxima foto">
                    <Icon name="chevron-right" size={20} color="var(--text-primary)" />
                  </button>
                </>
              )}
              <span class="jf-galeria-count" data-gallery-count aria-live="polite">Foto 1 de {fotos.length}</span>
              <button type="button" class="jf-galeria-open" data-gallery-open aria-label="Ver foto em tela cheia">Ampliar</button>
            </div>
            {fotos.length > 1 && (
              <div class="jf-thumbs jf-scroll" data-thumbs role="group" aria-label="Miniaturas">
                {fotos.map((f, i) => (
                  <button type="button" class="jf-thumb" data-thumb aria-label={`Foto ${i + 1} de ${fotos.length}`} aria-current={i === 0 ? 'true' : undefined} aria-pressed={i === 0 ? 'true' : 'false'}>
                    <img src={img(f, 160)} srcset={srcset(f, [160, 240])} sizes="112px" width="112" height="84" alt="" loading="lazy" decoding="async" />
                  </button>
                ))}
              </div>
            )}
            <dialog class="jf-fs" data-gallery-dialog aria-label={`Fotos de ${v.nome}`}>
              <div class="jf-fs-stage" data-fs-stage>
                <img data-fs-img src={slides[0].src} srcset={slides[0].srcset} sizes="100vw" alt={v.nome} />
              </div>
              <button type="button" class="jf-fs-close" data-fs-close aria-label="Fechar">Fechar</button>
              {fotos.length > 1 && (
                <>
                  <button type="button" class="jf-galeria-arrow jf-galeria-prev" data-fs-prev aria-label="Foto anterior">
                    <Icon name="chevron-left" size={20} color="var(--text-primary)" />
                  </button>
                  <button type="button" class="jf-galeria-arrow jf-galeria-next" data-fs-next aria-label="Próxima foto">
                    <Icon name="chevron-right" size={20} color="var(--text-primary)" />
                  </button>
                </>
              )}
              <span class="jf-galeria-count" data-fs-count aria-live="polite">Foto 1 de {fotos.length}</span>
            </dialog>
          </>
        ) : (
          <div class="jf-galeria-stage"><span class="jf-galeria-label">Sem foto</span></div>
        )}
      </div>

      <div class="jf-det-body">
        <section class="jf-det-block">
          <h2 class="jf-det-h2">Sobre a moto</h2>
          <p class="jf-det-desc">{v.descricao}</p>
        </section>

        <section class="jf-det-block">
          <h2 class="jf-det-h2">Ficha técnica</h2>
          <dl class="jf-ficha-grid">
            {fichas.map(([label, value]) => (
              <div class="jf-ficha-item">
                <dt class="jf-ficha-label">{label}</dt>
                <dd class="jf-ficha-value">{value}</dd>
              </div>
            ))}
          </dl>
        </section>

        {v.opcionais.length > 0 && (
          <section class="jf-det-block">
            <h2 class="jf-det-h2">Itens e opcionais</h2>
            <ul class="jf-opcionais-grid">
              {v.opcionais.map((op) => (
                <li class="jf-opcional"><span class="jf-opcional-check" aria-hidden="true">✓</span> {op}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    <div class="jf-mbar">
      <div class="jf-mbar-price">{brl(v.preco)}</div>
      <a href={interesseHref} target="_blank" rel="noopener" class="jf-btn jf-btn-wa" data-wa-track="veiculo_barra_fixa" data-wa-vehicle={v.nome}>Tenho interesse</a>
    </div>

    {similares.length > 0 && (
      <div class="jf-similares">
        <h2 class="jf-similares-h2">Outras opções na loja</h2>
        <div class="jf-g4">
          {similares.map((s) => <VehicleCard vehicle={s} />)}
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  import { initSimulador } from '../../scripts/detalhe';
  const simRoot = document.getElementById('jf-sim');
  if (simRoot) initSimulador(Number(simRoot.dataset.preco ?? 0));
</script>

<style>
  .jf-det-wrap { --wa: #0F7A40; max-width: 1240px; margin: 0 auto; padding: 26px 24px 20px; }
  .jf-breadcrumb { font-size: 13px; color: var(--text-tertiary); margin-bottom: 18px; }
  .jf-breadcrumb a { color: var(--text-tertiary); display: inline-block; padding: 12px 0; margin: -12px 0; }
  .jf-breadcrumb-current { color: var(--text-secondary); }

  .jf-det {
    display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 0 40px; align-items: start;
    grid-template-areas: "gallery aside" "body aside";
  }
  .jf-galeria { grid-area: gallery; min-width: 0; }
  .jf-det-body { grid-area: body; min-width: 0; }
  .jf-det-aside { grid-area: aside; position: sticky; top: 92px; display: flex; flex-direction: column; gap: 24px; }

  .jf-galeria-stage {
    position: relative; aspect-ratio: var(--ar, 4 / 3); width: min(100%, calc(78svh * var(--ar, 1.333))); margin-inline: auto;
    background: var(--surface-muted); border-radius: var(--radius-lg);
    overflow: hidden; display: flex; align-items: center; justify-content: center; touch-action: pan-y; user-select: none;
  }
  .jf-galeria-stage img { width: 100%; height: 100%; object-fit: contain; cursor: zoom-in; }
  .jf-galeria-label { font-size: 14px; color: var(--text-secondary); }
  .jf-galeria-arrow {
    position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px;
    border-radius: var(--radius-md); background: var(--surface-overlay); border: 1px solid var(--border-default);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
  }
  .jf-galeria-prev { left: 12px; }
  .jf-galeria-next { right: 12px; }
  .jf-galeria-count, .jf-galeria-open, .jf-fs-close {
    position: absolute; background: var(--surface-overlay); color: var(--text-primary); border: 1px solid var(--border-default);
    border-radius: var(--radius-md); font-size: 14px; font-weight: 700;
  }
  .jf-galeria-count { left: 12px; bottom: 12px; padding: 6px 10px; }
  .jf-galeria-open, .jf-fs-close { right: 12px; bottom: 12px; min-height: 44px; padding: 0 14px; cursor: pointer; }

  .jf-thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; padding-bottom: 4px; }
  .jf-thumb {
    flex: 0 0 112px; height: 84px; padding: 0; border-radius: var(--radius-sm); cursor: pointer; overflow: hidden;
    background: var(--surface-muted); border: 2px solid transparent; transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .jf-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .jf-thumb[aria-current='true'] { border-color: var(--accent); }

  .jf-fs {
    width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0;
    background: var(--surface-inverse);
  }
  .jf-fs::backdrop { background: var(--surface-inverse); }
  .jf-fs[open] { display: block; }
  .jf-fs-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .jf-fs-stage img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .jf-fs-close { top: 12px; bottom: auto; }

  .jf-det-title { font: 700 clamp(36px, 4vw, 48px)/1 var(--font-display); margin: 0 0 8px; }
  .jf-det-data { font-size: 16px; color: var(--text-secondary); margin: 0; }

  .jf-buy { display: flex; flex-direction: column; gap: 10px; padding-top: 20px; border-top: 1px solid var(--border-default); }
  .jf-price-value { font: 700 48px/1 var(--font-display); font-variant-numeric: tabular-nums; margin-bottom: 8px; }
  .jf-btn {
    display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 12px 20px;
    border-radius: var(--radius-md); font-weight: 700; font-size: 16px; text-align: center;
    transition: background var(--dur-fast) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
  }
  .jf-btn-wa { background: var(--wa); color: var(--white); }
  .jf-btn-wa:hover { color: var(--white); filter: brightness(.92); }
  .jf-btn-outline { border: 1px solid var(--text-primary); color: var(--text-primary); }
  .jf-btn-outline:hover { background: var(--surface-sunken); }
  .jf-fav-btn {
    display: flex; align-items: center; justify-content: center; gap: 8px; background: transparent;
    border: 1px solid var(--border-default); color: var(--text-secondary);
    font-weight: 700; font-size: 14px; min-height: 44px; border-radius: var(--radius-md); cursor: pointer;
  }
  .jf-fav-btn :global(svg) { fill: none; stroke: currentColor; transition: fill var(--dur-fast) var(--ease-standard); }
  .jf-fav-btn.is-active { color: var(--accent); border-color: var(--accent); }
  .jf-fav-btn.is-active :global(svg) { fill: var(--accent); }

  .jf-det-block { margin-top: 36px; }
  .jf-det-h2 { font: 700 24px var(--font-display); margin: 0 0 12px; }
  .jf-det-h3 { font: 700 18px var(--font-display); margin: 0 0 16px; }
  .jf-det-desc { font: var(--text-body-lg); color: var(--text-secondary); line-height: 1.75; margin: 0; }

  .jf-ficha-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; margin: 0; }
  .jf-ficha-item { padding: 12px 0; border-bottom: 1px solid var(--border-default); display: flex; justify-content: space-between; gap: 12px; }
  .jf-ficha-label { font-size: 14px; color: var(--text-secondary); }
  .jf-ficha-value { font-size: 14px; font-weight: 700; text-align: right; margin: 0; }

  .jf-opcionais-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .jf-opcional { display: flex; align-items: center; gap: 10px; font-size: 14.5px; color: var(--text-secondary); }
  .jf-opcional-check { color: var(--accent-strong); font-weight: 800; }

  .jf-sim-card { padding-top: 20px; border-top: 1px solid var(--border-default); }
  .jf-sim-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .jf-sim-row-top { margin-top: 20px; }
  .jf-filter-label { font: var(--text-caption); color: var(--text-tertiary); }
  .jf-filter-value { font-size: 13px; font-weight: 800; color: var(--accent-strong); }
  .jf-sim-sub { font-size: 13px; color: var(--text-secondary); margin-top: 10px; }
  .jf-sim-sub strong { color: var(--text-primary); }
  .jf-chips { display: flex; gap: 7px; flex-wrap: wrap; }
  .jf-chip-btn {
    padding: 9px 13px; min-height: 44px; border-radius: var(--radius-md); font-size: 13px; font-weight: 700; cursor: pointer;
    background: var(--surface-muted); border: 1px solid var(--border-default); color: var(--text-secondary);
  }
  .jf-chip-btn.is-active { background: var(--text-primary); border-color: var(--text-primary); color: var(--surface-card); }
  .jf-sim-result { margin-top: 20px; padding: 14px 16px; background: var(--surface-sunken); border-radius: var(--radius-md); display: flex; flex-direction: column; gap: 10px; }
  .jf-sim-result-row { display: flex; justify-content: space-between; font-size: 14px; color: var(--text-secondary); }
  .jf-sim-result-row strong { color: var(--text-primary); }
  .jf-sim-cta {
    display: flex; justify-content: center; align-items: center; min-height: 44px; margin-top: 14px; padding: 13px;
    border: 1px solid var(--text-primary); border-radius: var(--radius-md); font-size: 15px; font-weight: 700; color: var(--text-primary);
  }
  .jf-sim-disclaimer { font-size: 12px; color: var(--text-tertiary); margin: 14px 0 0; line-height: 1.5; }

  .jf-mbar { display: none; }

  .jf-similares { margin-top: 56px; }
  .jf-similares-h2 { font: 700 28px var(--font-display); margin: 0 0 20px; }
  .jf-g4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }

  @media (max-width: 980px) {
    .jf-det { grid-template-columns: minmax(0, 1fr); grid-template-areas: none; }
    .jf-det-aside { display: contents; position: static; }
    .jf-det-head { order: 1; margin-bottom: 16px; }
    .jf-galeria { order: 2; grid-area: auto; }
    .jf-buy { order: 3; margin-top: 20px; }
    .jf-sim-card { order: 4; margin-top: 20px; }
    .jf-det-body { order: 5; grid-area: auto; }
    .jf-g4 { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .jf-det-wrap { padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
    .jf-price-value { font-size: 40px; }
    :global(.jf-chat) { bottom: 85px !important; }
    .jf-mbar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: flex; align-items: center; gap: 12px;
      background: var(--surface-card); border-top: 1px solid var(--border-default);
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    }
    .jf-mbar-price { flex: 1; font: 700 24px var(--font-display); font-variant-numeric: tabular-nums; }
    .jf-mbar .jf-btn { padding: 0 22px; }
    .jf-ficha-grid, .jf-opcionais-grid, .jf-g4 { grid-template-columns: 1fr; }
  }
</style>
