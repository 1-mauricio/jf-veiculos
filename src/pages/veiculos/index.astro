---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import Icon from '../../components/Icon.astro';
import { brl } from '../../lib/format';

const veiculos = await getCollection('veiculos');

/** O campo marca é texto livre no CMS: "Honda" e "HONDA" não podem virar duas marcas diferentes no filtro. */
const marcaCanonica = new Map<string, string>();
for (const v of veiculos) {
  const key = v.data.marca.trim().toLowerCase();
  if (!marcaCanonica.has(key)) marcaCanonica.set(key, v.data.marca.trim());
}
const getMarca = (marca: string) => marcaCanonica.get(marca.trim().toLowerCase()) ?? marca;

const marcas = [...marcaCanonica.values()].sort();
const cores = [...new Set(veiculos.map((v) => v.data.cor))].sort();
const tipos = [...new Set(veiculos.map((v) => v.data.tipo))];
const cambios = [...new Set(veiculos.map((v) => v.data.cambio))].sort();
const combustiveis = [...new Set(veiculos.map((v) => v.data.combustivel))].sort();
const anos = veiculos.map((v) => v.data.ano);
const anoMinData = anos.length ? Math.min(...anos) : 2016;
const anoMaxData = anos.length ? Math.max(...anos) : 2024;
const precos = veiculos.map((v) => v.data.preco);
const precoStep = 1000;
const precoMinData = precos.length ? Math.floor(Math.min(...precos) / precoStep) * precoStep : 0;
const precoMaxData = precos.length ? Math.ceil(Math.max(...precos) / precoStep) * precoStep : 100000;
const kmStep = 5000;
const kmMaxData = Math.ceil(Math.max(0, ...veiculos.map((v) => v.data.km ?? 0)) / kmStep) * kmStep || kmStep;
const soMotos = veiculos.length > 0 && tipos.every((t) => t === 'moto');
const titulo = soMotos ? 'Motos disponíveis' : 'Veículos disponíveis';
const substantivo = soMotos ? 'motos' : 'veículos';
const temSecundarios = tipos.length > 1 || marcas.length > 1 || cambios.length > 1 || combustiveis.length > 1 || cores.length > 1;
const siteEntries = await getCollection('site');
const nomeSite = siteEntries[0]?.data.nomeSite ?? 'JF Veículos';
---

<BaseLayout title="Veículos" description={`Carros e motos seminovos disponíveis na ${nomeSite}, com filtros por preço, ano e km.`}>
  <div class="jf-listagem-wrap">
    <nav class="jf-breadcrumb" aria-label="Navegação"><a href="/">Início</a> <span>›</span> <span id="jf-titulo-crumb">{titulo}</span></nav>

    <div class="jf-listagem-head">
      <div>
        <h1 class="jf-h1" id="jf-titulo" data-padrao={titulo}>{titulo}</h1>
        <div class="jf-count" id="jf-count" role="status">{veiculos.length} {substantivo}</div>
      </div>
      <div class="jf-sort-wrap">
        <label class="jf-sort-label" for="jf-sort">Ordenar por</label>
        <select id="jf-sort">
          <option value="recentes">Mais recentes</option>
          <option value="menor">Menor preço</option>
          <option value="maior">Maior preço</option>
          <option value="km">Menor km</option>
        </select>
      </div>
    </div>

    <div class="jf-fbar">
      <button type="button" id="jf-filtrar" aria-haspopup="dialog" aria-controls="jf-filters"><Icon name="filter" size={18} />Filtrar</button>
    </div>

    <div class="jf-list">
      <!-- FILTROS -->
      <dialog class="jf-filters" id="jf-filters" aria-label="Filtros" closedby="any">
        <div class="jf-filters-head">
          <span class="jf-filters-title">Filtros</span>
          <span class="jf-filters-actions">
            <button type="button" id="jf-limpar" class="jf-limpar">Limpar</button>
            <button type="button" id="jf-filters-close" class="jf-close" aria-label="Fechar filtros"><Icon name="x" size={20} /></button>
          </span>
        </div>

        <div class="jf-filters-body" id="jf-filters-body">
          <div class="jf-filter-primary">
            <div class="jf-filter-group">
              <div class="jf-filter-row"><label class="jf-filter-label" for="jf-preco">Preço até</label><span class="jf-filter-value" id="jf-preco-val">{brl(precoMaxData)}</span></div>
              <input type="range" id="jf-preco" min={precoMinData} max={precoMaxData} step={precoStep} value={precoMaxData} aria-describedby="jf-preco-val" />
            </div>

            <div class="jf-filter-group">
              <div class="jf-filter-row"><label class="jf-filter-label" for="jf-ano">Ano mínimo</label><span class="jf-filter-value" id="jf-ano-val">{anoMinData}</span></div>
              <input type="range" id="jf-ano" min={anoMinData} max={anoMaxData} step="1" value={anoMinData} aria-describedby="jf-ano-val" />
            </div>

            <div class="jf-filter-group">
              <div class="jf-filter-row"><label class="jf-filter-label" for="jf-km">Km até</label><span class="jf-filter-value" id="jf-km-val">{kmMaxData.toLocaleString('pt-BR')} km</span></div>
              <input type="range" id="jf-km" min="0" max={kmMaxData} step={kmStep} value={kmMaxData} aria-describedby="jf-km-val" />
            </div>
          </div>

          {temSecundarios && (
            <details class="jf-more">
              <summary>Mais filtros</summary>
              <div class="jf-more-body">
                {tipos.length > 1 && (
                  <div class="jf-filter-group">
                    <div class="jf-filter-label" id="jf-tipo-label">Tipo</div>
                    <div class="jf-chips" data-chip-group="tipo" role="group" aria-labelledby="jf-tipo-label">
                      <button type="button" class="jf-chip-btn" data-value="todos">Todos</button>
                      <button type="button" class="jf-chip-btn" data-value="carro">Carros</button>
                      <button type="button" class="jf-chip-btn" data-value="moto">Motos</button>
                    </div>
                  </div>
                )}

                {marcas.length > 1 && (
                  <div class="jf-filter-group">
                    <label class="jf-filter-label" for="jf-marca">Marca</label>
                    <select id="jf-marca" class="jf-select">
                      <option value="todas">Todas as marcas</option>
                      {marcas.map((m) => <option value={m}>{m}</option>)}
                    </select>
                  </div>
                )}

                {cambios.length > 1 && (
                  <div class="jf-filter-group">
                    <div class="jf-filter-label" id="jf-cambio-label">Câmbio</div>
                    <div class="jf-chips" data-chip-group="cambio" role="group" aria-labelledby="jf-cambio-label">
                      <button type="button" class="jf-chip-btn" data-value="todos">Todos</button>
                      {cambios.map((c) => <button type="button" class="jf-chip-btn" data-value={c}>{c}</button>)}
                    </div>
                  </div>
                )}

                {combustiveis.length > 1 && (
                  <div class="jf-filter-group">
                    <div class="jf-filter-label" id="jf-combustivel-label">Combustível</div>
                    <div class="jf-chips" data-chip-group="combustivel" role="group" aria-labelledby="jf-combustivel-label">
                      <button type="button" class="jf-chip-btn" data-value="todos">Todos</button>
                      {combustiveis.map((c) => <button type="button" class="jf-chip-btn" data-value={c}>{c}</button>)}
                    </div>
                  </div>
                )}

                {cores.length > 1 && (
                  <div class="jf-filter-group">
                    <label class="jf-filter-label" for="jf-cor">Cor</label>
                    <select id="jf-cor" class="jf-select">
                      <option value="todas">Todas as cores</option>
                      {cores.map((c) => <option value={c}>{c}</option>)}
                    </select>
                  </div>
                )}
              </div>
            </details>
          )}
        </div>
        <button type="button" id="jf-filters-apply" class="jf-apply">Ver {veiculos.length} {substantivo}</button>
      </dialog>

      <!-- GRID -->
      <div>
        <div class="jf-g3" id="jf-grid">
          {[...veiculos].sort((a, b) => b.data.criadoEm.getTime() - a.data.criadoEm.getTime()).map((v, i) => (
            <div
              class="jf-grid-item"
              data-vehicle-card
              data-tipo={v.data.tipo}
              data-marca={getMarca(v.data.marca)}
              data-criado={v.data.criadoEm.getTime()}
              data-preco={v.data.preco}
              data-ano={v.data.ano}
              data-km={v.data.km ?? 0}
              data-cambio={v.data.cambio}
              data-combustivel={v.data.combustivel}
              data-cor={v.data.cor}
              data-busca={`${v.data.nome} ${v.data.marca}`.toLowerCase()}
            >
              <VehicleCard vehicle={v} priority={i === 0} headingLevel={2} />
            </div>
          ))}
        </div>
        <div id="jf-empty" class="jf-empty" hidden>
          <div class="jf-empty-icon"><Icon name="search" size={34} color="var(--text-tertiary)" /></div>
          <div class="jf-empty-title">Nenhum veículo com esses filtros</div>
          <div class="jf-empty-sub">Tente ampliar a faixa de preço ou limpar os filtros.</div>
          <button type="button" id="jf-limpar-2" class="jf-empty-btn">Limpar filtros</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initListagem } from '../../scripts/listagem';
  initListagem();
</script>

<style>
  .jf-listagem-wrap { max-width: 1240px; margin: 0 auto; padding: 30px 24px 20px; }
  .jf-breadcrumb { font-size: 13px; color: var(--text-secondary); margin-bottom: 18px; }
  .jf-breadcrumb a { color: var(--text-secondary); }

  .jf-listagem-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .jf-h1 { font: 700 32px var(--font-display); margin: 0 0 4px; }
  .jf-count { font-size: 14px; color: var(--text-secondary); }
  .jf-sort-wrap { display: flex; align-items: center; gap: 10px; }
  .jf-sort-label { font-size: 13px; color: var(--text-secondary); }
  #jf-sort {
    background: var(--surface-sunken); border: 1px solid var(--border-default); color: var(--text-primary);
    font: 600 14px var(--font-body, inherit); padding: 11px 12px; min-height: 44px; border-radius: var(--radius-md); cursor: pointer;
  }

  .jf-fbar { display: none; margin-bottom: 16px; }
  .jf-fbar button {
    flex: 1; min-height: 48px; border-radius: var(--radius-md); border: 1px solid var(--border-strong);
    background: var(--surface-card); color: var(--text-primary); font: 600 15px var(--font-body, inherit);
    display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer;
  }

  .jf-list { display: grid; gap: 20px; }
  /* <dialog> fora do modo modal funciona como barra horizontal no desktop */
  .jf-filters {
    position: static; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 16px 28px; margin: 0; width: auto; max-width: none; max-height: none; color: inherit;
    background: none; border: 0; border-block: 1px solid var(--border-default); padding: 16px 0;
  }
  .jf-filters-head { display: flex; align-items: center; justify-content: space-between; order: 2; margin-left: auto; }
  .jf-filters-title { display: none; }
  .jf-filters-body { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 16px 28px; flex: 1; }
  .jf-filter-primary { display: flex; flex-wrap: wrap; gap: 16px 28px; }
  .jf-more { flex-basis: 100%; }
  .jf-more summary {
    display: inline-flex; align-items: center; min-height: 44px; cursor: pointer; font: 700 14px var(--font-body, inherit); color: var(--text-primary);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .jf-more-body { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 16px 28px; padding: 8px 0 4px; }
  .jf-filters-actions { display: flex; align-items: center; gap: 4px; }
  .jf-limpar { background: none; border: none; font: 700 12.5px var(--font-body, inherit); color: var(--accent-strong); cursor: pointer; padding: 12px 0; }
  .jf-close, .jf-apply { display: none; }
  .jf-close { background: none; border: none; color: var(--text-primary); width: 44px; height: 44px; align-items: center; justify-content: center; cursor: pointer; }

  .jf-filter-group { min-width: 0; }
  .jf-filter-label { display: block; font: 600 13px var(--font-body, inherit); color: var(--text-secondary); margin: 0 0 6px; }
  .jf-filter-row { display: flex; justify-content: space-between; gap: 12px; }
  .jf-filter-value { font-size: 13px; font-weight: 700; color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .jf-filter-group input[type=range] { width: 160px; max-width: 100%; accent-color: var(--accent); }

  .jf-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .jf-chip-btn {
    padding: 9px 13px; min-height: 44px; border-radius: var(--radius-md); font: 600 14px var(--font-body, inherit); cursor: pointer;
    background: var(--surface-muted); border: 1px solid var(--border-default); color: var(--text-secondary);
  }
  .jf-chip-btn.is-active { background: var(--text-primary); border-color: var(--text-primary); color: var(--surface-card); }

  .jf-select {
    width: auto; min-width: 150px; background: var(--surface-sunken); border: 1px solid var(--border-default); color: var(--text-primary);
    font: 600 14px var(--font-body, inherit); padding: 11px 12px; min-height: 44px; border-radius: var(--radius-md); cursor: pointer;
  }

  .jf-g3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
  .jf-grid-item { display: contents; }
  .jf-grid-item[hidden] { display: none; }

  .jf-empty { text-align: center; padding: 64px 20px; border: 1px solid var(--border-default); border-radius: var(--radius-md); }
  .jf-empty-icon { display: flex; justify-content: center; margin-bottom: 14px; }
  .jf-empty-title { font: 700 18px var(--font-display); margin-bottom: 6px; }
  .jf-empty-sub { font-size: 14px; color: var(--text-secondary); margin-bottom: 18px; }
  .jf-empty-btn {
    border: none; background: var(--accent); color: var(--white); font-weight: 700; font-size: 14px;
    padding: 12px 22px; min-height: 44px; border-radius: var(--radius-md); cursor: pointer;
  }

  :global(html:has(dialog.jf-filters:modal)) { overflow: hidden; }
  @media (max-width: 620px) {
    .jf-listagem-wrap { padding-inline: 16px; }
    .jf-fbar { display: flex; }
    /* sidebar vira bottom sheet aberto pelo botão Filtrar */
    .jf-filters {
      display: none; position: fixed; background: var(--surface-card); border: 0; padding: 20px; inset: auto 0 0 0; width: 100%; max-height: 88dvh; overflow-y: auto; overscroll-behavior: contain;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      transition-property: translate, display, overlay;
      transition-duration: var(--dur-base, .25s);
      transition-timing-function: ease-out;
      transition-behavior: allow-discrete;
      translate: 0 100%;
    }
    .jf-filters[open] {
      display: block; translate: 0 0;
      @starting-style { translate: 0 100%; }
    }
    .jf-filters::backdrop {
      background: rgb(0 0 0 / 0);
      transition-property: background-color, display, overlay;
      transition-duration: var(--dur-base, .25s);
      transition-behavior: allow-discrete;
    }
    .jf-filters[open]::backdrop {
      background: rgb(0 0 0 / .5);
      @starting-style { background: rgb(0 0 0 / 0); }
    }
    .jf-filters-head { margin: 0 0 16px; }
    .jf-filters-title { display: block; font: 700 18px var(--font-display); }
    .jf-filters-body, .jf-filter-primary, .jf-more-body { flex-direction: column; align-items: stretch; gap: 20px; }
    .jf-select, .jf-filter-group input[type=range] { width: 100%; }
    .jf-close { display: flex; }
    .jf-apply {
      display: block; width: 100%; margin-top: 22px; min-height: 48px; border: none; border-radius: var(--radius-md);
      background: var(--accent); color: var(--white); font: 700 15px var(--font-body, inherit); cursor: pointer;
    }
  }
</style>
