---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { whatsappLink } from '../lib/format';

const veiculos = await getCollection('veiculos');
const depoimentos = await getCollection('depoimentos');
const lojaEntries = await getCollection('loja');
const loja = lojaEntries[0]?.data;
const siteEntries = await getCollection('site');
const site = siteEntries[0]?.data;
const nomeSite = site?.nomeSite ?? 'JF Veículos';

const totalVeiculos = veiculos.length;
const whatsappHref = loja ? whatsappLink(loja.whatsapp, `Olá! Vim pelo site da ${nomeSite}.`) : '#';
const instagramHref = loja?.instagram ? `https://instagram.com/${loja.instagram}` : null;
---

<BaseLayout title="Nossa loja" description={`Conheça a ${nomeSite}: seminovos revisados e as melhores condições de financiamento.`}>
  <!-- HERO LOJA -->
  <section class="jf-loja-hero">
    <div class="jf-loja-hero-inner">
      <div class="jf-loja-head">
        <Logo size={110} radius="var(--radius-lg)" />
        <div class="jf-loja-head-text">
          <div class="jf-loja-title-row">
            <h1 class="jf-loja-title">{nomeSite}</h1>
          </div>
          {loja && (
            <div class="jf-loja-meta">
              <span>{loja.cidade} · {loja.uf}</span>
              <span>·</span>
              <span>Desde {loja.anoFundacao}</span>
            </div>
          )}
        </div>
        <div class="jf-loja-actions">
          <Button href={whatsappHref} target="_blank" variant="whatsapp">
            <Icon name="whatsapp" size={17} color="var(--white)" /> WhatsApp
          </Button>
          {instagramHref && (
            <a href={instagramHref} target="_blank" rel="noopener" class="jf-loja-instagram" aria-label={`Instagram da ${nomeSite}`}>
              <Icon name="instagram" size={18} color="var(--white)" /> @{loja?.instagram}
            </a>
          )}
        </div>
      </div>

      <div class="jf-g4stat">
        <div class="jf-stat"><div class="jf-stat-value">{totalVeiculos}</div><div class="jf-stat-label">anúncios ativos</div></div>
      </div>
    </div>
  </section>

  <!-- SOBRE -->
  <section class="jf-loja-section">
    <div class="jf-sobre">
      <div>
        <h2 class="jf-h2b">Sobre a {nomeSite}</h2>
        <p class="jf-sobre-text">{loja?.sobre}</p>
        {loja?.historia && (
          <>
            <button type="button" id="jf-historia-toggle" class="jf-historia-toggle" aria-expanded="false" aria-controls="jf-historia-text">
              Conheça nossa história →
            </button>
            <p class="jf-sobre-text jf-historia-text" id="jf-historia-text" hidden>{loja.historia}</p>
          </>
        )}
      </div>
      <div class="jf-sobre-card">
        <div class="jf-sobre-item"><span class="jf-check">✓</span> Financiamento próprio e via bancos</div>
        <div class="jf-sobre-item"><span class="jf-check">✓</span> Aceitamos seu usado na troca</div>
        <div class="jf-sobre-item"><span class="jf-check">✓</span> Garantia de motor e câmbio</div>
        <div class="jf-sobre-item"><span class="jf-check">✓</span> Entrega em todo o estado</div>
      </div>
    </div>
  </section>

  <!-- AVALIACOES -->
  {depoimentos.length > 0 && (
    <section class="jf-loja-section">
      <h2 class="jf-h2b">O que dizem os clientes</h2>
      <div class="jf-g3">
        {depoimentos.map((d) => (
          <div class="jf-avaliacao">
            <p class="jf-avaliacao-text">"{d.data.texto}"</p>
            <div class="jf-avaliacao-author">
              <div class="jf-avaliacao-avatar">{d.data.nome[0]}</div>
              <div>
                <div class="jf-avaliacao-name">{d.data.nome}</div>
                <div class="jf-avaliacao-local">{d.data.local}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const historiaToggle = document.getElementById('jf-historia-toggle');
  const historiaText = document.getElementById('jf-historia-text');
  historiaToggle?.addEventListener('click', () => {
    const isHidden = historiaText?.hidden;
    if (historiaText) historiaText.hidden = !isHidden;
    historiaToggle.setAttribute('aria-expanded', String(!!isHidden));
    historiaToggle.textContent = isHidden ? 'Conheça nossa história ↑' : 'Conheça nossa história →';
  });
</script>

<style>
  .jf-loja-hero { position: relative; background: linear-gradient(180deg, var(--black-950), var(--black-900)); }
  .jf-loja-hero-inner { max-width: 1240px; margin: 0 auto; padding: 48px 24px 0; }
  .jf-loja-head { display: flex; gap: 24px; align-items: flex-end; flex-wrap: wrap; }
  .jf-loja-head-text { flex: 1; padding-bottom: 6px; }
  .jf-loja-title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .jf-loja-title { font: 700 30px var(--font-display); color: var(--white); letter-spacing: -.7px; margin: 0; }
  .jf-loja-meta { display: flex; align-items: center; gap: 16px; margin-top: 8px; flex-wrap: wrap; color: var(--text-on-dark-secondary); font-size: 14px; }
  .jf-loja-actions { display: flex; gap: 10px; padding-bottom: 6px; }
  .jf-loja-instagram {
    display: flex; align-items: center; gap: 8px; height: 42px; padding: 0 18px;
    background: transparent; border: 1px solid rgba(255, 255, 255, .24); border-radius: var(--radius-full);
    color: var(--white); font-weight: 700; font-size: 14px;
  }
  .jf-loja-instagram:hover { border-color: rgba(255, 255, 255, .5); color: var(--white); }

  .jf-g4stat { display: grid; grid-template-columns: repeat(1, 1fr); gap: 14px; margin: 34px 0 0; padding-bottom: 34px; max-width: 220px; }
  .jf-stat { background: rgba(255, 255, 255, .06); border-radius: var(--radius-md); padding: 18px; }
  .jf-stat-value { font: 700 24px var(--font-display); color: var(--white); }
  .jf-stat-label { font-size: 13px; color: var(--text-on-dark-secondary); margin-top: 2px; }

  .jf-loja-section { max-width: 1240px; margin: 0 auto; padding: 40px 24px 0; }
  .jf-h2b { font: 700 21px var(--font-display); margin: 0 0 18px; }

  .jf-sobre { display: grid; grid-template-columns: 1.7fr 1fr; gap: 26px; align-items: start; }
  .jf-sobre-text { font: var(--text-body-lg); color: var(--text-secondary); line-height: 1.75; margin: 0; }
  .jf-historia-toggle {
    display: inline-flex; margin-top: 14px; background: none; border: none; padding: 0; cursor: pointer;
    font-weight: 700; font-size: 15px; color: var(--accent-strong);
  }
  .jf-historia-toggle:hover { color: var(--accent); }
  .jf-historia-text { margin-top: 14px; }
  .jf-sobre-card {
    background: var(--white); border: 1px solid var(--border-default); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card); padding: 22px; display: flex; flex-direction: column; gap: 14px;
  }
  .jf-sobre-item { display: flex; gap: 10px; align-items: center; font-size: 14px; color: var(--text-secondary); }
  .jf-check { color: var(--success); }

  .jf-g3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .jf-avaliacao { background: var(--white); border: 1px solid var(--border-default); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); padding: 24px; display: flex; flex-direction: column; height: 100%; }
  .jf-avaliacao-text { font: var(--text-body); color: var(--text-secondary); line-height: 1.7; margin: 0 0 18px; }
  .jf-avaliacao-author { display: flex; align-items: center; gap: 11px; margin-top: auto; }
  .jf-avaliacao-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--gray-100); display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--text-secondary); }
  .jf-avaliacao-name { font-weight: 700; font-size: 14px; }
  .jf-avaliacao-local { font-size: 12.5px; color: var(--text-tertiary); }

  @media (max-width: 980px) {
    .jf-sobre { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .jf-g4stat, .jf-g3 { grid-template-columns: 1fr; }
  }
</style>
