---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ComoChegar from '../components/ComoChegar.astro';
import { whatsappLink, formatPhone } from '../lib/format';

const veiculos = await getCollection('veiculos');
const motos = veiculos.filter((veiculo) => veiculo.data.tipo === 'moto').length;
const depoimentos = (await getCollection('depoimentos')).slice(0, 3);
const loja = (await getCollection('loja'))[0]?.data;
const nomeSite = (await getCollection('site'))[0]?.data.nomeSite ?? 'JF Veículos';
const whatsappHref = loja ? whatsappLink(loja.whatsapp, `Olá! Vim pelo site da ${nomeSite}.`) : '#';
const instagramHref = loja?.instagram ? `https://instagram.com/${loja.instagram}` : null;
---

<BaseLayout title="Nossa loja" description={`Conheça a ${nomeSite} em Recife.`}>
  <div class="loja-conteudo">
    <section class="loja-abertura">
      <h1>{nomeSite}</h1>
      {loja && <p class="loja-local">Desde {loja.anoFundacao} em {loja.cidade.trim()}</p>}
      {loja?.sobre && <p class="loja-sobre">{loja.sobre}</p>}
      {loja?.historia?.trim() && <p class="loja-sobre">{loja.historia}</p>}
      <a class="loja-link" href="/veiculos?tipo=moto">Ver {motos === 1 ? 'a moto' : `as ${motos} motos`} na loja →</a>
    </section>

    <figure class="loja-foto">
      <img src="/images/site/background.jpeg" alt={`Fachada da ${nomeSite}`} />
      <figcaption>{nomeSite} em {loja?.cidade.trim()}</figcaption>
    </figure>

    {loja && <section class="loja-secao">
      <h2>Visite ou fale com a gente</h2>
      <dl class="loja-contatos">
        <div><dt>Endereço</dt><dd>{loja.endereco}, {loja.cidade.trim()} - {loja.uf}</dd></div>
        <div><dt>Horário</dt><dd>{loja.horarios}</dd></div>
        <div><dt>WhatsApp</dt><dd><a href={whatsappHref} target="_blank" rel="noopener" data-wa-track="loja_contato">{formatPhone(loja.whatsapp)}</a></dd></div>
        {instagramHref && <div><dt>Instagram</dt><dd><a href={instagramHref} target="_blank" rel="noopener">@{loja.instagram}</a></dd></div>}
      </dl>
    </section>}

    {depoimentos.length > 0 && <section class="loja-secao">
      <h2>O que dizem os clientes</h2>
      <div class="loja-depoimentos">
        {depoimentos.map((d) => <figure class="loja-citacao"><blockquote>“{d.data.texto}”</blockquote><figcaption>{d.data.nome} · {d.data.local}</figcaption></figure>)}
      </div>
      {loja?.mapsLink && <a class="loja-link" href={loja.mapsLink} target="_blank" rel="noopener">Ver avaliações no Google →</a>}
    </section>}

    {loja && <section class="loja-secao"><ComoChegar titleClass="loja-titulo-mapa" /></section>}
  </div>
</BaseLayout>

<style>
  .loja-conteudo { max-width: 1240px; margin: 0 auto; padding: 0 var(--space-6) var(--space-8); }
  .loja-abertura { max-width: 760px; padding: var(--space-12) 0 var(--space-8); }
  h1 { font: var(--text-display); color: var(--text-primary); margin: 0; }
  h2, :global(.loja-titulo-mapa) { font: var(--text-h2); color: var(--text-primary); margin: 0 0 var(--space-5); }
  .loja-local { font: var(--text-h3); color: var(--text-secondary); margin: var(--space-2) 0 var(--space-6); }
  .loja-sobre { font: var(--text-body-lg); color: var(--text-secondary); margin: 0 0 var(--space-4); }
  .loja-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .loja-foto { margin: 0; }
  .loja-foto img { display: block; width: 100%; max-height: 520px; object-fit: cover; border-radius: var(--radius-md); }
  .loja-foto figcaption { font: var(--text-small); color: var(--text-secondary); margin-top: var(--space-2); }
  .loja-secao { padding-top: var(--space-12); }
  .loja-contatos { margin: 0; max-width: 760px; border-top: 1px solid var(--border-default); }
  .loja-contatos div { display: grid; grid-template-columns: 150px 1fr; gap: var(--space-4); align-items: center; min-height: 52px; border-bottom: 1px solid var(--border-default); }
  .loja-contatos dt { font-weight: 600; }
  .loja-contatos dd { margin: 0; color: var(--text-secondary); }
  .loja-contatos a { display: inline-flex; align-items: center; min-height: 44px; }
  .loja-depoimentos { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  .loja-citacao { border-top: 1px solid var(--border-default); margin: 0; padding-top: var(--space-4); }
  .loja-citacao blockquote { margin: 0 0 var(--space-4); color: var(--text-secondary); line-height: 1.5; }
  .loja-citacao figcaption { font-weight: 600; }
  @media (max-width: 620px) {
    .loja-depoimentos { grid-template-columns: 1fr; gap: var(--space-5); }
    .loja-contatos div { grid-template-columns: 1fr; gap: 0; padding: var(--space-3) 0; }
  }
</style>
