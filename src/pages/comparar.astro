---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { brl, km as fmtKm } from '../lib/format';

const veiculos = await getCollection('veiculos');

const linhas: [string, (v: (typeof veiculos)[number]['data']) => string][] = [
  ['Preço', (v) => brl(v.preco)],
  ['Ano/Modelo', (v) => `${v.ano}/${v.anoModelo}`],
  ['Quilometragem', (v) => (v.km != null ? fmtKm(v.km) : '—')],
  ['Câmbio', (v) => v.cambio],
  ['Combustível', (v) => v.combustivel],
  ['Cor', (v) => v.cor],
  ['Cidade', (v) => `${v.cidade || 'Recife'} · ${v.uf || 'PE'}`],
];
---

<BaseLayout title="Comparar veículos" description="Compare lado a lado os veículos que você favoritou.">
  <div class="jf-cmp-wrap">
    <div class="jf-breadcrumb"><a href="/">Início</a> <span>›</span> <a href="/favoritos">Meus favoritos</a> <span>›</span> <span>Comparar</span></div>
    <h1 class="jf-h1">Comparar veículos</h1>

    <div class="jf-cmp-scroll" id="jf-cmp-scroll" hidden>
      <table class="jf-cmp-table">
        <thead>
          <tr>
            <th class="jf-cmp-label-col"></th>
            {veiculos.map((v) => (
              <th data-vehicle-cell data-id={v.id} hidden>
                <a href={`/veiculos/${v.id}`} class="jf-cmp-thumb" style={v.data.fotos[0] ? `background-image: url(${v.data.fotos[0]});` : undefined}></a>
                <div class="jf-cmp-nome">{v.data.nome}</div>
                <button type="button" class="jf-cmp-remove" data-fav-btn data-vehicle-id={v.id} aria-label={`Remover ${v.data.nome} da comparação`}>
                  <Icon name="x" size={13} /> Remover
                </button>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {linhas.map(([label, get]) => (
            <tr>
              <td class="jf-cmp-label-col">{label}</td>
              {veiculos.map((v) => (
                <td data-vehicle-cell data-id={v.id} hidden>{get(v.data)}</td>
              ))}
            </tr>
          ))}
          <tr>
            <td class="jf-cmp-label-col"></td>
            {veiculos.map((v) => (
              <td data-vehicle-cell data-id={v.id} hidden>
                <Button href={`/veiculos/${v.id}`} variant="outline" class="jf-cmp-cta">Ver anúncio</Button>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>

    <div id="jf-cmp-empty" class="jf-empty" hidden>
      <div class="jf-empty-icon"><Icon name="heart" size={34} color="var(--text-tertiary)" /></div>
      <div class="jf-empty-title">Favorite pelo menos 2 veículos para comparar</div>
      <div class="jf-empty-sub">Clique no coração de um anúncio pra salvá-lo e depois volte aqui.</div>
      <Button href="/veiculos">Ver todos os veículos</Button>
    </div>
  </div>
</BaseLayout>

<script>
  import { initComparar } from '../scripts/comparar-page';
  initComparar();
</script>

<style>
  .jf-cmp-wrap { max-width: 1240px; margin: 0 auto; padding: 30px 24px 40px; }
  .jf-breadcrumb { font-size: 13px; color: var(--text-tertiary); margin-bottom: 18px; }
  .jf-breadcrumb a { color: var(--text-tertiary); }
  .jf-h1 { font: 700 28px var(--font-display); letter-spacing: -.6px; margin: 0 0 20px; }

  .jf-cmp-scroll { overflow-x: auto; border: 1px solid var(--border-default); border-radius: var(--radius-lg); }
  .jf-cmp-table { border-collapse: collapse; width: 100%; }
  .jf-cmp-table th, .jf-cmp-table td { padding: 14px 18px; border-bottom: 1px solid var(--border-default); text-align: left; white-space: nowrap; }
  .jf-cmp-table tr:last-child td { border-bottom: none; }
  .jf-cmp-label-col { position: sticky; left: 0; background: var(--white); font-size: 13px; color: var(--text-secondary); font-weight: 600; z-index: 1; }

  .jf-cmp-thumb {
    display: block; width: 140px; height: 90px; border-radius: var(--radius-md);
    background-color: var(--gray-100); background-size: contain; background-repeat: no-repeat; background-position: center;
  }
  .jf-cmp-nome { font: 700 15px var(--font-display); margin: 10px 0 8px; }
  .jf-cmp-remove {
    display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 700; color: var(--text-tertiary);
    background: var(--gray-100); border: none; border-radius: var(--radius-full); padding: 5px 10px; cursor: pointer;
  }
  .jf-cmp-remove:hover { color: var(--text-primary); }
  .jf-cmp-cta { padding: 9px 16px; font-size: 13px; }

  .jf-empty {
    text-align: center; padding: 80px 20px; background: var(--white);
    border: 1px dashed var(--border-strong); border-radius: var(--radius-lg);
  }
  .jf-empty-icon { display: flex; justify-content: center; margin-bottom: 14px; }
  .jf-empty-title { font: 700 18px var(--font-display); margin-bottom: 6px; }
  .jf-empty-sub { font-size: 14px; color: var(--text-secondary); margin-bottom: 18px; }
</style>
