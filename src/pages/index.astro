---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VehicleCard from '../components/VehicleCard.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import ComoChegar from '../components/ComoChegar.astro';
import { whatsappLink, brl, km as fmtKm } from '../lib/format';

const veiculos = await getCollection('veiculos');
const depoimentos = await getCollection('depoimentos');
const lojaEntries = await getCollection('loja');
const loja = lojaEntries[0]?.data;
const siteEntries = await getCollection('site');
const site = siteEntries[0]?.data;

const destaque = veiculos.find((v) => v.data.destaque) ?? veiculos[0];
const catAte20 = veiculos.filter((v) => v.data.preco > 0 && v.data.preco <= 20000).length;
const catCarros = veiculos.filter((v) => v.data.tipo === 'carro').length;
const catMotos = veiculos.filter((v) => v.data.tipo === 'moto').length;

/** Destaques primeiro, depois o resto do pátio; o veículo do topo não se repete. */
const patio = [
  ...veiculos.filter((v) => v.data.destaque && v.id !== destaque?.id),
  ...veiculos.filter((v) => !v.data.destaque && v.id !== destaque?.id),
].slice(0, 8);

const zapHref = loja ? whatsappLink(loja.whatsapp, 'Olá! Vim pelo site da JF Veículos.') : '/loja';
const destaqueZap = loja && destaque
  ? whatsappLink(loja.whatsapp, `Olá! Vi a ${destaque.data.nome} ${destaque.data.ano} no site. Ainda está disponível?`)
  : zapHref;
const vendaHref = loja ? whatsappLink(loja.whatsapp, 'Olá! Quero avaliar meu veículo para venda ou troca.') : '/loja';

const faq = [
  ['Quais documentos preciso para financiar?', 'RG, CPF, comprovante de residência e de renda. Autônomos também conseguem aprovação: a gente orienta no WhatsApp.'],
  ['Vocês aceitam meu usado na troca?', 'Sim. Avaliamos seu carro ou moto na hora e o valor entra como entrada do próximo.'],
  ['O que a garantia cobre?', 'Todo veículo sai com garantia de motor e câmbio. Os detalhes e o prazo ficam por escrito no contrato.'],
  ['Entregam fora de Recife?', 'Sim, entregamos em todo o estado de Pernambuco.'],
];
const vantagens = [1, 2, 3]
  .map((n) => ({
    titulo: site?.[`vantagem${n}Titulo` as 'vantagem1Titulo'],
    desc: site?.[`vantagem${n}Desc` as 'vantagem1Desc'],
  }))
  .filter((v) => v.titulo);

const atalhos = [
  catMotos > 0 && { href: '/veiculos?tipo=moto', label: 'Motos', n: catMotos },
  catCarros > 0 && { href: '/veiculos?tipo=carro', label: 'Carros', n: catCarros },
  catAte20 > 0 && { href: '/veiculos?precoMax=20000', label: 'Até R$ 20 mil', n: catAte20 },
].filter(Boolean) as { href: string; label: string; n: number }[];

const d = destaque?.data;
const fotoDestaque = d?.fotos?.[0];
---

<BaseLayout title={site?.nomeSite ?? 'JF Veículos'}>
  <!-- VITRINE: a moto da semana com o preço escrito no vidro -->
  <section class="jf-vitrine" aria-labelledby="vitrine-h">
    <div class="jf-vitrine-inner">
      {destaque && d && (
        <a href={`/veiculos/${destaque.id}`} class="jf-pane" aria-describedby="vitrine-preco">
          {fotoDestaque
            ? <img src={fotoDestaque} alt={d.nome} fetchpriority="high" decoding="async" />
            : <span class="jf-pane-empty jf-hand">foto em breve</span>}
          <div class="jf-pane-ink" aria-hidden="true">
            <span class="jf-pane-price jf-hand">{d.preco > 0 ? brl(d.preco) : 'consulte'}</span>
            <span class="jf-pane-model jf-hand">{d.nome} · {d.ano}</span>
            <span class="jf-pane-note jf-hand">{d.km != null ? `${fmtKm(d.km)} · ` : ''}revisada · laudo ok</span>
          </div>
        </a>
      )}

      <div class="jf-vitrine-copy">
        <h1 id="vitrine-h" class="jf-vitrine-title">
          {site?.heroTituloInicio ?? 'Realizando'} <span class="jf-hand jf-vitrine-hand">{site?.heroTituloDestaque ?? 'sonhos'}</span>
        </h1>
        <p class="jf-vitrine-sub">{site?.heroSubtitulo}</p>
        {d && <p id="vitrine-preco" class="jf-sr">{d.nome} {d.ano}, {d.preco > 0 ? brl(d.preco) : 'preço sob consulta'}</p>}
        <a href={destaque ? destaqueZap : zapHref} target="_blank" rel="noopener" class="jf-zap" data-wa-track="home_hero" data-wa-vehicle={d?.nome}>
          <Icon name="whatsapp" size={22} color="currentColor" />
          {destaque ? 'Perguntar dessa no WhatsApp' : 'Chamar no WhatsApp'}
        </a>
        <div class="jf-vitrine-links">
          <a href="/veiculos">Ver o pátio todo</a>
          <a href={vendaHref} target="_blank" rel="noopener" data-wa-track="home_hero_vender">Quero vender ou trocar o meu</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BUSCA + ATALHOS -->
  <section class="jf-busca" aria-label="Buscar no estoque">
    <form class="jf-busca-form" method="GET" action="/veiculos" role="search">
      <label for="home-busca" class="jf-sr">Buscar moto ou carro</label>
      <Icon name="search" size={20} color="currentColor" />
      <input id="home-busca" name="busca" placeholder="Qual moto você procura? Ex: CG 160, Biz, Bros" autocomplete="off" />
      <button type="submit" class="jf-busca-go">Buscar</button>
    </form>
    {atalhos.length > 0 && (
      <nav class="jf-atalhos jf-scroll" aria-label="Atalhos do estoque">
        {atalhos.map((a) => (
          <a href={a.href} class="jf-atalho">{a.label} <span class="jf-num">{a.n}</span></a>
        ))}
        <a href="/veiculos" class="jf-atalho">Tudo <span class="jf-num">{veiculos.length}</span></a>
      </nav>
    )}
  </section>

  <!-- PÁTIO -->
  {patio.length > 0 && (
    <section class="jf-section" aria-labelledby="patio-h">
      <div class="jf-section-head">
        <h2 id="patio-h" class="jf-h2">No pátio agora</h2>
        <a href="/veiculos" class="jf-more">Ver todos os {veiculos.length}</a>
      </div>
      <div class="jf-grid">
        {patio.map((v) => <VehicleCard vehicle={v} />)}
      </div>
    </section>
  )}

  <!-- POR QUE AQUI: uma ficha, não três cartões de ícone -->
  {vantagens.length > 0 && (
    <section class="jf-section" aria-labelledby="ficha-h">
      <div class="jf-ficha">
        <div class="jf-ficha-head">
          <h2 id="ficha-h" class="jf-h2">Por que comprar aqui</h2>
          <p class="jf-ficha-stamp jf-hand">220 itens checados</p>
        </div>
        <ol class="jf-ficha-list">
          {vantagens.map((v) => (
            <li>
              <h3>{v.titulo}</h3>
              <p>{v.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- DEPOIMENTOS -->
  {depoimentos.length > 0 && (
    <section class="jf-section" aria-labelledby="depo-h">
      <div class="jf-section-head">
        <h2 id="depo-h" class="jf-h2">Quem comprou aqui</h2>
        {loja && (
          <p class="jf-rating">
            <strong class="jf-num">{loja.avaliacaoMedia.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}</strong> no Google · {loja.numAvaliacoes} avaliações
          </p>
        )}
      </div>
      <div class="jf-depos jf-scroll">
        {depoimentos.map((dp) => (
          <figure class="jf-depo">
            <blockquote>{dp.data.texto}</blockquote>
            <figcaption><strong>{dp.data.nome}</strong> · {dp.data.local}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- VENDA / TROCA: a faixa de posca -->
  <section class="jf-troca" aria-labelledby="troca-h">
    <div class="jf-troca-inner">
      <div>
        <h2 id="troca-h" class="jf-troca-title">{site?.ctaFinalTitulo ?? 'Quer vender ou trocar o seu?'}</h2>
        <p class="jf-troca-sub">{site?.ctaFinalTexto ?? 'Avaliamos seu veículo na hora e você sai daqui com o próximo.'}</p>
      </div>
      <Button href={vendaHref} target="_blank" variant="dark" data-wa-track="home_cta_final">
        <Icon name="whatsapp" size={20} color="currentColor" />
        {site?.ctaFinalBotao ?? 'Avaliar meu veículo'}
      </Button>
    </div>
  </section>

  <section class="jf-section">
    <ComoChegar titleClass="jf-h2" />
  </section>

  <section class="jf-section jf-faq" aria-labelledby="faq-h">
    <h2 id="faq-h" class="jf-h2">Perguntas que todo mundo faz</h2>
    <div class="jf-faq-list">
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .jf-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* ---------- Vitrine ---------- */
  .jf-vitrine { background: var(--asphalt-900); color: var(--posca-white); }
  .jf-vitrine-inner {
    max-width: 1240px; margin: 0 auto; padding: 32px 24px 40px;
    display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 40px; align-items: center;
  }
  .jf-pane {
    position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden;
    border-radius: var(--radius-lg); background: var(--glass-700); color: var(--posca-white);
    outline-offset: 4px;
  }
  .jf-pane img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s var(--ease-standard); }
  .jf-pane:hover img { transform: scale(1.02); }
  .jf-pane-empty { position: absolute; inset: 0; display: grid; place-items: center; font-size: 28px; color: var(--text-on-dark-secondary); }
  .jf-pane-ink {
    position: absolute; inset: 0; padding: clamp(18px, 4vw, 36px);
    display: flex; flex-direction: column; align-items: flex-start; gap: 6px;
    background:
      linear-gradient(118deg, rgba(255,255,255,.13) 0 22%, rgba(255,255,255,0) 22% 100%),
      linear-gradient(to bottom, rgba(16,18,20,.72), rgba(16,18,20,0) 58%);
  }
  .jf-pane-price {
    font-size: clamp(48px, 9vw, 92px); line-height: .95; color: var(--posca-white);
    transform: rotate(-4deg); transform-origin: left top; text-shadow: 0 2px 0 rgba(0,0,0,.3);
  }
  .jf-pane-model { font-size: clamp(22px, 3.6vw, 34px); color: var(--accent-on-dark); transform: rotate(-3deg); margin-top: 8px; }
  .jf-pane-note { font-size: clamp(16px, 2.4vw, 22px); color: var(--posca-white); transform: rotate(-2deg); opacity: .92; }

  .jf-vitrine-title {
    font: 800 clamp(36px, 5vw, 56px)/1.02 var(--font-display); font-stretch: 80%;
    text-transform: uppercase; letter-spacing: -.01em; margin: 0 0 16px;
  }
  .jf-vitrine-hand { display: inline-block; font-size: 1.05em; text-transform: none; color: var(--accent-on-dark); transform: rotate(-3deg); }
  .jf-vitrine-sub { font: 400 17px/1.5 var(--font-body); color: var(--text-on-dark-secondary); margin: 0 0 28px; max-width: 46ch; }

  .jf-zap {
    display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 58px; padding: 0 22px;
    border-radius: var(--radius-md); background: var(--accent); color: var(--on-accent);
    font: 800 17px/1.1 var(--font-body); text-transform: uppercase; letter-spacing: .02em; text-align: center;
    transition: background var(--dur-fast) var(--ease-standard), transform var(--dur-fast) var(--ease-standard);
  }
  .jf-zap:hover { color: var(--on-accent); background: color-mix(in srgb, var(--accent) 88%, var(--posca-white)); }
  .jf-zap:active { transform: translateY(1px); }
  .jf-vitrine-links { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 16px; }
  .jf-vitrine-links a {
    color: var(--posca-white); font: 700 15px var(--font-body); min-height: 44px; display: inline-flex; align-items: center;
    text-decoration: underline; text-decoration-color: var(--accent-on-dark); text-decoration-thickness: 2px; text-underline-offset: 5px;
  }
  .jf-vitrine-links a:hover { color: var(--accent-on-dark); }

  /* ---------- Busca ---------- */
  .jf-busca { max-width: 1240px; margin: 0 auto; padding: 28px 24px 0; }
  .jf-busca-form {
    display: flex; align-items: center; gap: 10px; padding: 6px 6px 6px 16px;
    background: var(--surface-card); border: 2px solid var(--text-primary); border-radius: var(--radius-md); color: var(--text-secondary);
  }
  .jf-busca-form:focus-within { outline: 3px solid var(--accent); outline-offset: 2px; }
  .jf-busca-form input {
    flex: 1; min-width: 0; min-height: 48px; border: none; outline: none; background: none;
    font: 500 16px var(--font-body); color: var(--text-primary);
  }
  .jf-busca-form input::placeholder { color: var(--text-label); }
  .jf-busca-go {
    min-height: 48px; padding: 0 20px; border: none; border-radius: var(--radius-sm); cursor: pointer;
    background: var(--text-primary); color: var(--surface-page); font: 800 14px var(--font-body); text-transform: uppercase; letter-spacing: .04em;
  }
  .jf-atalhos { display: flex; gap: 8px; margin-top: 12px; overflow-x: auto; padding-bottom: 4px; }
  .jf-atalho {
    flex-shrink: 0; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px;
    border: 1px solid var(--border-strong); border-radius: var(--radius-md);
    font: 700 14px var(--font-body); color: var(--text-primary); text-transform: uppercase; letter-spacing: .03em;
  }
  .jf-atalho span { color: var(--text-secondary); font-weight: 600; }
  .jf-atalho:hover { border-color: var(--text-primary); color: var(--text-primary); }

  /* ---------- Seções ---------- */
  .jf-section { max-width: 1240px; margin: 0 auto; padding: 56px 24px 0; }
  .jf-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px 16px; flex-wrap: wrap; margin-bottom: 20px; }
  .jf-more {
    font: 700 15px var(--font-body); color: var(--text-primary); min-height: 44px; display: inline-flex; align-items: center;
    text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 5px;
  }
  .jf-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }

  /* Ficha de inspeção */
  .jf-ficha {
    display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 32px;
    padding: 32px; border-radius: var(--radius-lg); background: var(--surface-card); border: 1px solid var(--border-default);
  }
  .jf-ficha-head { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .jf-ficha-stamp { margin: 0; font-size: 34px; line-height: 1; color: var(--accent-strong); transform: rotate(-3deg); transform-origin: left; }
  .jf-ficha-list { list-style: none; margin: 0; padding: 0; counter-reset: ficha; }
  .jf-ficha-list li { counter-increment: ficha; display: grid; grid-template-columns: 36px 1fr; column-gap: 12px; padding: 16px 0; border-top: 1px solid var(--border-default); }
  .jf-ficha-list li:first-child { border-top: none; padding-top: 0; }
  .jf-ficha-list li::before { content: counter(ficha) "."; grid-row: span 2; font: 400 24px/1.1 var(--font-hand); color: var(--accent-strong); }
  .jf-ficha-list h3 { margin: 0 0 4px; font: 800 17px/1.25 var(--font-body); text-transform: uppercase; letter-spacing: .02em; }
  .jf-ficha-list p { margin: 0; font: var(--text-body); color: var(--text-secondary); max-width: 60ch; }

  /* Depoimentos */
  .jf-rating { margin: 0; font: 500 15px var(--font-body); color: var(--text-secondary); }
  .jf-rating strong { color: var(--text-primary); font-size: 18px; }
  .jf-depos { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, 1fr); gap: 16px; overflow-x: auto; padding-bottom: 6px; scroll-snap-type: x mandatory; }
  .jf-depo { margin: 0; padding: 22px 22px 18px; background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-md); scroll-snap-align: start; display: flex; flex-direction: column; gap: 14px; }
  .jf-depo blockquote { margin: 0; font: 400 17px/1.55 var(--font-body); color: var(--text-primary); }
  .jf-depo blockquote::before { content: "“"; display: block; font: 400 40px/0.6 var(--font-hand); color: var(--accent-strong); margin-bottom: 8px; }
  .jf-depo figcaption { margin-top: auto; font: 400 14px var(--font-body); color: var(--text-secondary); }
  .jf-depo figcaption strong { color: var(--text-primary); }

  /* Faixa de troca */
  .jf-troca { margin-top: 64px; background: var(--accent); color: var(--on-accent); }
  .jf-troca-inner { max-width: 1240px; margin: 0 auto; padding: 40px 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px 40px; flex-wrap: wrap; }
  .jf-troca-title { margin: 0 0 6px; font: 400 clamp(30px, 4.4vw, 46px)/1.05 var(--font-hand); transform: rotate(-1.5deg); transform-origin: left; }
  .jf-troca-sub { margin: 0; font: 600 17px/1.45 var(--font-body); max-width: 52ch; }

  /* FAQ */
  .jf-faq { max-width: 860px; }
  .jf-faq .jf-h2 { margin-bottom: 16px; }
  .jf-faq-list { border-top: 2px solid var(--text-primary); }
  .jf-faq details { border-bottom: 1px solid var(--border-default); }
  .jf-faq summary {
    min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; list-style: none;
    font: 700 17px/1.3 var(--font-body); color: var(--text-primary);
  }
  .jf-faq summary::-webkit-details-marker { display: none; }
  .jf-faq summary::after { content: "+"; font: 400 26px/1 var(--font-hand); color: var(--accent-strong); transition: transform var(--dur-base) var(--ease-standard); }
  .jf-faq details[open] summary::after { transform: rotate(45deg); }
  .jf-faq details p { margin: 0 0 18px; font: var(--text-body-lg); color: var(--text-secondary); max-width: 65ch; }

  @media (max-width: 1100px) { .jf-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 980px) {
    .jf-vitrine-inner { grid-template-columns: 1fr; gap: 24px; padding-top: 16px; }
    .jf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .jf-ficha { grid-template-columns: 1fr; gap: 24px; padding: 24px; }
  }
  @media (max-width: 620px) {
    .jf-vitrine-inner { padding: 12px 12px 28px; }
    .jf-vitrine-copy { padding: 0 4px; }
    .jf-vitrine-links { flex-direction: column; gap: 0; margin-top: 8px; }
    .jf-vitrine-sub { display: none; }
    .jf-vitrine-title { margin-bottom: 14px; }
    .jf-vitrine-inner { padding-bottom: 16px; }
    .jf-busca, .jf-section { padding-left: 16px; padding-right: 16px; }
    .jf-section { padding-top: 44px; }
    .jf-grid { grid-template-columns: 1fr; gap: 14px; }
    .jf-busca-go { padding: 0 14px; }
    .jf-troca-inner { padding: 32px 16px; }
    .jf-troca-inner :global(.jf-btn) { width: 100%; }
  }
</style>
