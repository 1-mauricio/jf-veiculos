---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VehicleCard from '../components/VehicleCard.astro';
import Button from '../components/Button.astro';
import ComoChegar from '../components/ComoChegar.astro';
import { whatsappLink, brl, km as fmtKm } from '../lib/format';
import { img, srcset } from '../lib/img';

const veiculos = await getCollection('veiculos');
const depoimentos = await getCollection('depoimentos');
const lojaEntries = await getCollection('loja');
const loja = lojaEntries[0]?.data;
const siteEntries = await getCollection('site');
const site = siteEntries[0]?.data;

const ordenados = [...veiculos].sort((a, b) => Number(b.data.destaque) - Number(a.data.destaque));
const destaque = ordenados.find((v) => v.id === site?.heroVeiculo) ?? ordenados[0];
const estoque = ordenados.filter((v) => v !== destaque).slice(0, 6);
const heroFoto = destaque?.data.fotos[0];
const SALAO = '/images/site/background.jpeg';

const zapHref = loja ? whatsappLink(loja.whatsapp, 'Olá! Vim pelo site da JF Veículos.') : '/loja';
const faq = [
  ['Quais documentos preciso para financiar?', 'RG, CPF, comprovante de residência e de renda. Autônomos também conseguem aprovação: a gente orienta no WhatsApp.'],
  ['Vocês aceitam meu usado na troca?', 'Sim. Mande fotos, ano e quilometragem pelo WhatsApp e a gente conversa sobre a avaliação.'],
  ['O que a garantia cobre?', 'O prazo e o que está coberto ficam por escrito no contrato.'],
  ['Entregam fora de Recife?', 'Fale com a equipe pelo WhatsApp para combinar a entrega.'],
];
const vantagens = [1, 2, 3].map((n) => ({
  titulo: site?.[`vantagem${n}Titulo` as 'vantagem1Titulo'],
  desc: site?.[`vantagem${n}Desc` as 'vantagem1Desc'],
}));
const [destaqueDep, ...outrosDep] = depoimentos.slice(0, 3);

const vendaHref = loja ? whatsappLink(loja.whatsapp, 'Olá! Quero avaliar meu veículo para venda ou troca.') : '/loja';
---

<BaseLayout title={site?.nomeSite ?? 'JF Veículos'}>
  <section class="jf-hero">
    <div class="jf-hgrid">
      <div class="jf-hero-copy">
        <h1 class="jf-hero-title">
          <span>{site?.heroTituloInicio}</span>
          <span class="jf-hl">{site?.heroTituloDestaque}</span>
        </h1>
        <span class="jf-bar jf-slant" aria-hidden="true"></span>
        <p class="jf-hero-sub">{site?.heroSubtitulo}</p>
        <div class="jf-hero-actions">
          <Button href="/veiculos">Ver motos disponíveis</Button>
          <Button href={zapHref} target="_blank" variant="whatsapp" data-wa-track="home_hero">Falar no WhatsApp</Button>
        </div>
      </div>
      {destaque && (
        <a href={`/veiculos/${destaque.id}`} class="jf-feat">
          <div class="jf-feat-stage">
            <span class="jf-slab jf-slant" aria-hidden="true"></span>
            {heroFoto && (
              <img
                src={img(heroFoto, 800)}
                srcset={srcset(heroFoto, [480, 800, 1200])}
                sizes="(max-width: 980px) 100vw, 560px"
                width="800" height="600" alt={destaque.data.nome}
                fetchpriority="high" loading="eager" decoding="async"
              />
            )}
          </div>
          <div class="jf-feat-info">
            <div>
              <div class="jf-feat-name">{destaque.data.nome}</div>
              <div class="jf-feat-meta">{destaque.data.ano}{destaque.data.km != null ? ` · ${fmtKm(destaque.data.km)}` : ''}</div>
            </div>
            <div class="jf-feat-price">{brl(destaque.data.preco)}</div>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="jf-wrap jf-search-wrap" aria-label="Buscar motos">
    <form class="jf-search" method="GET" action="/veiculos">
      <div class="jf-field">
        <label for="qs-busca">Modelo</label>
        <input id="qs-busca" name="busca" placeholder="CG 160, Biz, XRE" />
      </div>
      <div class="jf-field">
        <label for="qs-preco">Orçamento</label>
        <select id="qs-preco" name="precoMax">
          <option value="200000">Qualquer valor</option>
          <option value="15000">Até R$ 15 mil</option>
          <option value="20000">Até R$ 20 mil</option>
          <option value="30000">Até R$ 30 mil</option>
        </select>
      </div>
      <Button type="submit" variant="dark">Buscar</Button>
    </form>
    <p class="jf-quicklinks">
      <a href="/veiculos?precoMax=15000">Até R$ 15 mil</a>
      <a href="/veiculos?precoMax=20000">Até R$ 20 mil</a>
      <a href="/veiculos">Todo o estoque</a>
    </p>
  </section>

  {estoque.length > 0 && (
    <section class="jf-stock">
      <div class="jf-wrap">
        <h2 class="jf-h2">Motos disponíveis</h2>
        <div class="jf-stock-grid" role="region" aria-label="Motos disponíveis" tabindex="0">
          {estoque.map((v) => <VehicleCard vehicle={v} />)}
        </div>
        <a href="/veiculos" class="jf-link">Ver todas as {veiculos.length} motos <span aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  <section class="jf-troca">
    <div class="jf-wrap jf-troca-in">
      <div>
        <h2 class="jf-troca-h">Sua moto pode entrar na troca</h2>
        <p>Mande fotos, ano e quilometragem. A gente responde com a avaliação.</p>
      </div>
      <Button href={vendaHref} target="_blank" variant="dark" data-wa-track="home_troca">Mandar fotos no WhatsApp</Button>
    </div>
  </section>

  <section class="jf-salao">
    <div class="jf-wrap jf-salao-in">
      <img
        src={img(SALAO, 1200)}
        srcset={srcset(SALAO, [640, 960, 1280, 1800])}
        sizes="(max-width: 980px) 100vw, 720px"
        width="1200" height="800" alt="Salão da JF Veículos com as motos expostas" loading="lazy" decoding="async"
      />
      <div class="jf-salao-txt">
        <h2 class="jf-salao-h">Venha ver de perto</h2>
        {loja && <p>{loja.endereco}, {loja.cidade.trim()}.<br />{loja.horarios}.</p>}
        <p>Veja a moto, confira a documentação e converse com a equipe antes de decidir.</p>
        {loja?.mapsLink && <Button href={loja.mapsLink} target="_blank" variant="white">Como chegar</Button>}
      </div>
    </div>
  </section>

  {destaqueDep && (
    <section class="jf-wrap jf-dep" aria-labelledby="dep-h">
      <h2 id="dep-h" class="jf-h2">Quem já comprou</h2>
      <div class="jf-dep-grid">
        <figure class="jf-quote-main">
          <blockquote>“{destaqueDep.data.texto}”</blockquote>
          <figcaption>{destaqueDep.data.nome}, {destaqueDep.data.local}</figcaption>
        </figure>
        <div class="jf-quote-side">
          {outrosDep.map((d) => (
            <figure class="jf-quote">
              <blockquote>“{d.data.texto}”</blockquote>
              <figcaption>{d.data.nome}, {d.data.local}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      {loja?.mapsLink && <a href={loja.mapsLink} target="_blank" rel="noopener" class="jf-link">Ver avaliações no Google <span aria-hidden="true">→</span></a>}
    </section>
  )}

  <section class="jf-wrap jf-vant" aria-labelledby="vantagens-h">
    <h2 id="vantagens-h" class="jf-h2">Comprar na {site?.nomeSite ?? 'JF Veículos'}</h2>
    <ul class="jf-list">
      {vantagens.map((v) => (
        <li>
          <h3 class="jf-h3">{v.titulo}</h3>
          <p>{v.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="jf-wrap jf-map">
    <ComoChegar titleClass="jf-h2" />
  </section>

  <section class="jf-wrap jf-faq" aria-labelledby="faq-h">
    <h2 id="faq-h" class="jf-h2">Perguntas frequentes</h2>
    <div class="jf-faq-list">
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .jf-wrap { max-width: 1240px; margin: 0 auto; padding-inline: 24px; }
  .jf-slant { background: var(--accent); clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%); }

  .jf-hero { max-width: 1240px; margin: 0 auto; padding: 48px 24px 0; }
  .jf-hgrid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; }
  .jf-hero-title { font: 700 clamp(44px, 6vw, 88px)/0.95 var(--font-display); text-transform: uppercase; margin: 0; }
  .jf-hero-title span { display: block; }
  .jf-hl { color: var(--accent); }
  .jf-bar { display: block; width: 120px; height: 10px; margin: 24px 0; }
  .jf-hero-sub { font-size: 18px; line-height: 1.5; color: var(--text-secondary); margin: 0; max-width: 480px; }
  .jf-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .jf-feat { display: block; color: inherit; }
  .jf-feat:hover { color: inherit; }
  .jf-feat-stage { position: relative; isolation: isolate; }
  .jf-feat-stage img { position: relative; z-index: 1; }
  .jf-slab { position: absolute; z-index: 0; inset: 8% -4% -6% 22%; }
  .jf-feat-stage img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; }
  .jf-feat-info { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding-top: 16px; }
  .jf-feat-name { font: 700 24px var(--font-display); }
  .jf-feat-meta { font-size: 15px; color: var(--text-secondary); }
  .jf-feat-price { font: 700 40px/1 var(--font-display); font-variant-numeric: tabular-nums; }

  .jf-search-wrap { padding-top: 32px; }
  .jf-search { display: grid; grid-template-columns: 2fr 1fr auto; gap: 12px; align-items: end; padding-top: 24px; border-top: 1px solid var(--border-default); }
  .jf-field { display: flex; flex-direction: column; gap: 4px; }
  .jf-field label { font: var(--text-caption); color: var(--text-label); }
  .jf-field select, .jf-field input {
    min-height: 44px; padding: 0 12px; font: inherit; color: var(--text-primary); background: var(--surface-card);
    border: 1px solid var(--border-default); border-radius: var(--radius-sm);
  }
  .jf-quicklinks { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 12px 0 0; }
  .jf-quicklinks a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  .jf-h2 { font: 700 clamp(30px, 3.4vw, 40px)/1.1 var(--font-display); margin: 0; }
  .jf-h3 { font: 700 20px var(--font-display); margin: 0; }
  .jf-link { display: inline-block; margin-top: 24px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  .jf-stock { background: var(--surface-card); margin-top: 48px; padding: 80px 0; }
  .jf-stock-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 32px; }

  .jf-troca { background: var(--accent); color: #fff; clip-path: polygon(0 28px, 100% 0, 100% 100%, 0 100%); padding: 72px 0 40px; }
  .jf-troca-in { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .jf-troca-h { font: 700 clamp(30px, 3.4vw, 44px)/1.05 var(--font-display); margin: 0 0 8px; }
  .jf-troca p { margin: 0; font-size: 18px; }

  .jf-salao { background: var(--surface-inverse); color: var(--text-on-dark); padding: 80px 0; }
  .jf-salao-in { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: center; }
  .jf-salao img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius-sm); }
  .jf-salao-h { font: 700 clamp(36px, 4.4vw, 56px)/1 var(--font-display); text-transform: uppercase; margin: 0 0 20px; }
  .jf-salao-txt p { margin: 0 0 16px; font-size: 18px; line-height: 1.5; color: var(--text-on-dark-secondary); }
  .jf-salao-txt p:first-of-type { color: var(--text-on-dark); }

  .jf-dep { padding-top: 80px; padding-bottom: 0; }
  .jf-dep-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; margin-top: 32px; }
  .jf-quote-main { margin: 0; }
  .jf-quote-main blockquote { margin: 0 0 16px; font: 600 clamp(24px, 2.6vw, 32px)/1.25 var(--font-display); }
  .jf-quote-side { display: grid; align-content: start; }
  .jf-quote { margin: 0; padding: 16px 0; border-top: 1px solid var(--border-default); }
  .jf-quote:first-child { padding-top: 0; border-top: 0; }
  .jf-quote blockquote { margin: 0 0 8px; font-size: 16px; line-height: 1.5; }
  figcaption { font-size: 14px; color: var(--text-secondary); }

  .jf-vant { padding-top: 48px; }
  .jf-list { list-style: none; margin: 24px 0 0; padding: 0; }
  .jf-list li { padding: 20px 0; border-top: 1px solid var(--border-default); display: grid; grid-template-columns: 1fr 2fr; gap: 24px; }
  .jf-list li:last-child { border-bottom: 1px solid var(--border-default); }
  .jf-list p { margin: 0; font: var(--text-body); color: var(--text-secondary); }

  .jf-map { padding-top: 80px; }
  .jf-faq { max-width: 820px; padding-top: 48px; padding-bottom: 80px; }
  .jf-faq .jf-h2 { margin-bottom: 16px; }
  .jf-faq details { border-top: 1px solid var(--border-default); padding: 6px 0; }
  .jf-faq details:last-child { border-bottom: 1px solid var(--border-default); }
  .jf-faq summary { font: 700 18px var(--font-display); cursor: pointer; min-height: 44px; display: flex; align-items: center; }
  .jf-faq details p { font-size: 16px; line-height: 1.6; color: var(--text-secondary); margin: 0 0 14px; }

  @media (max-width: 980px) {
    .jf-hgrid, .jf-salao-in, .jf-dep-grid { grid-template-columns: 1fr; gap: 32px; }
    .jf-stock-grid { grid-template-columns: 1fr 1fr; }
    .jf-list li { grid-template-columns: 1fr; gap: 6px; }
  }
  @media (max-width: 620px) {
    .jf-search { grid-template-columns: 1fr; }
    .jf-stock-grid {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 82%; gap: 16px;
      overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
      margin-inline: -24px; padding: 0 24px 8px; scroll-padding-inline: 24px; scrollbar-width: none;
    }
    .jf-stock-grid::-webkit-scrollbar { display: none; }
    .jf-stock-grid > * { scroll-snap-align: start; }
    .jf-stock, .jf-salao { padding: 48px 0; }
    .jf-feat-price { font-size: 32px; }
  }
</style>
