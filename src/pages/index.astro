---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VehicleCard from '../components/VehicleCard.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { whatsappLink, brl, km as fmtKm } from '../lib/format';

const veiculos = await getCollection('veiculos');
const depoimentos = await getCollection('depoimentos');
const lojaEntries = await getCollection('loja');
const loja = lojaEntries[0]?.data;
const siteEntries = await getCollection('site');
const site = siteEntries[0]?.data;

const destaque = veiculos.find((v) => v.data.destaque) ?? veiculos[0];
const catAte20 = veiculos.filter((v) => v.data.preco <= 20000).length;
const catCarros = veiculos.filter((v) => v.data.tipo === 'carro').length;
const catMotos = veiculos.filter((v) => v.data.tipo === 'moto').length;
const destaques = veiculos.filter((v) => v.data.destaque).slice(0, 4);
/** O campo marca é texto livre no CMS: "Honda" e "HONDA" não podem virar duas marcas diferentes no filtro. */
const marcaCanonica = new Map<string, string>();
for (const v of veiculos) {
  const key = v.data.marca.trim().toLowerCase();
  if (!marcaCanonica.has(key)) marcaCanonica.set(key, v.data.marca.trim());
}
const marcas = [...marcaCanonica.values()].sort();

const zapHref = loja ? whatsappLink(loja.whatsapp, 'Olá! Vim pelo site da JF Veículos.') : '/loja';
const faq = [
  ['Quais documentos preciso para financiar?', 'RG, CPF, comprovante de residência e de renda. Autônomos também conseguem aprovação: a gente orienta no WhatsApp.'],
  ['Vocês aceitam meu usado na troca?', 'Sim. Avaliamos seu carro ou moto na hora e o valor entra como entrada do próximo.'],
  ['O que a garantia cobre?', 'Todo veículo sai com garantia de motor e câmbio. Os detalhes e o prazo ficam por escrito no contrato.'],
  ['Entregam fora de Recife?', 'Sim, entregamos em todo o estado de Pernambuco.'],
];
const vantagens = [1, 2, 3].map((n) => ({
  titulo: site?.[`vantagem${n}Titulo` as 'vantagem1Titulo'],
  desc: site?.[`vantagem${n}Desc` as 'vantagem1Desc'],
  icon: (['cart', 'shield', 'gauge'] as const)[n - 1],
}));

const vendaHref = loja ? whatsappLink(loja.whatsapp, 'Olá! Quero avaliar meu veículo para venda ou troca.') : '/loja';
---

<BaseLayout title={site?.nomeSite ?? 'JF Veículos'}>
  <!-- HERO -->
  <section class="jf-hero">
    <div class="jf-hero-inner">
      <div class="jf-hgrid">
        <div class="jf-hero-copy">
          <a href={vendaHref} target="_blank" rel="noopener" class="jf-sell-pill" data-wa-track="home_hero_vender">
            <span>{site?.ctaFinalTitulo ?? 'Quer vender ou trocar o seu?'}</span>
            <strong>Avaliamos na hora →</strong>
          </a>
          <h1 class="jf-hero-title">{site?.heroTituloInicio} <span class="jf-accent-text">{site?.heroTituloDestaque}</span>.</h1>
          <p class="jf-hero-sub">{site?.heroSubtitulo}</p>
          <div class="jf-hero-actions">
            <a href={zapHref} target="_blank" rel="noopener" class="jf-hero-wa" data-wa-track="home_hero">
              <span class="jf-hero-wa-ico" aria-hidden="true"><Icon name="whatsapp" size={22} color="#0F7A40" /></span>Falar no WhatsApp
            </a>
            {loja?.instagram && (
              <a href={`https://instagram.com/${loja.instagram}`} target="_blank" rel="noopener" class="jf-hero-ghost jf-hero-ig" aria-label={`Instagram @${loja.instagram}`}>
                <Icon name="instagram" size={22} />
              </a>
            )}
            <a href="/veiculos" class="jf-hero-ghost">Ver estoque →</a>
          </div>
          <div class="jf-trust">
            {site?.veiculosVendidos && <div><div class="jf-trust-n">{site.veiculosVendidos}</div><div class="jf-trust-l">veículos vendidos</div></div>}
            {loja && <div><div class="jf-trust-n">Desde {loja.anoFundacao}</div><div class="jf-trust-l">no mercado</div></div>}
          </div>
        </div>
        {destaque && (
          <a href={`/veiculos/${destaque.id}`} class="jf-feat">
            <div class="jf-feat-photo" style={destaque.data.fotos[0] ? `background-image:url('${destaque.data.fotos[0]}')` : undefined}>
              {!destaque.data.fotos[0] && <span>SEM FOTO</span>}
              <span class="jf-feat-badge">DESTAQUE DA SEMANA</span>
            </div>
            <div class="jf-feat-info">
              <div>
                <div class="jf-feat-meta">{destaque.data.marca} · {destaque.data.ano}{destaque.data.km != null ? ` · ${fmtKm(destaque.data.km)}` : ''}</div>
                <div class="jf-feat-name">{destaque.data.nome}</div>
              </div>
              <div class="jf-feat-price"><div>{brl(destaque.data.preco)}</div><small>financie em até 60x</small></div>
            </div>
          </a>
        )}
      </div>

      <form class="jf-quick" method="GET" action="/veiculos">
        <div class="jf-quick-field">
          <label for="qs-tipo">Tipo</label>
          <select id="qs-tipo" name="tipo">
            <option value="todos">Carros e motos</option>
            <option value="carro">Carros</option>
            <option value="moto">Motos</option>
          </select>
        </div>
        <div class="jf-quick-field jf-quick-sep">
          <label for="qs-marca">Marca</label>
          <select id="qs-marca" name="marca">
            <option value="todas">Todas as marcas</option>
            {marcas.map((m) => <option value={m}>{m}</option>)}
          </select>
        </div>
        <div class="jf-quick-field jf-quick-sep">
          <label for="qs-preco">Até</label>
          <select id="qs-preco" name="precoMax">
            <option value="200000">Qualquer preço</option>
            <option value="40000">Até R$ 40 mil</option>
            <option value="70000">Até R$ 70 mil</option>
            <option value="100000">Até R$ 100 mil</option>
            <option value="150000">Até R$ 150 mil</option>
          </select>
        </div>
        <div class="jf-quick-field jf-quick-sep">
          <label for="qs-busca">Busca livre</label>
          <input id="qs-busca" name="busca" placeholder="Ex: Corolla, HB20, CB 500..." />
        </div>
        <button type="submit" class="jf-quick-btn">
          <Icon name="search" size={17} color="currentColor" />
          Buscar
        </button>
      </form>

      <form class="jf-msearch" method="GET" action="/veiculos">
        <label for="m-busca" class="jf-sr">Buscar veículo</label>
        <input id="m-busca" name="busca" placeholder="Buscar moto ou carro" />
        <a href="/veiculos" class="jf-msearch-filters">Filtros</a>
        <button type="submit" class="jf-msearch-go" aria-label="Buscar"><Icon name="search" size={18} color="currentColor" /></button>
      </form>
    </div>
  </section>

  <!-- CATEGORIAS -->
  <section class="jf-section">
    <div class="jf-cats">
      {catMotos > 0 && (
        <a href="/veiculos?tipo=moto" class="jf-cat-card">
          <div class="jf-cat-icon"><Icon name="gauge" size={21} color="var(--text-primary)" /></div>
          <div class="jf-cat-title">Motos</div>
          <div class="jf-cat-sub">{catMotos} {catMotos === 1 ? 'disponível' : 'disponíveis'}</div>
        </a>
      )}
      {catCarros > 0 && (
        <a href="/veiculos?tipo=carro" class="jf-cat-card">
          <div class="jf-cat-icon"><Icon name="car" size={21} color="var(--text-primary)" /></div>
          <div class="jf-cat-title">Carros</div>
          <div class="jf-cat-sub">{catCarros} {catCarros === 1 ? 'disponível' : 'disponíveis'}</div>
        </a>
      )}
      {catAte20 > 0 && (
        <a href="/veiculos?precoMax=20000" class="jf-cat-card">
          <div class="jf-cat-icon"><Icon name="cart" size={21} color="var(--text-primary)" /></div>
          <div class="jf-cat-title">Até R$ 20 mil</div>
          <div class="jf-cat-sub">{catAte20} {catAte20 === 1 ? 'disponível' : 'disponíveis'}</div>
        </a>
      )}
      <a href="/veiculos" class="jf-cat-card">
        <div class="jf-cat-icon"><Icon name="check" size={21} color="var(--text-primary)" /></div>
        <div class="jf-cat-title">Estoque</div>
        <div class="jf-cat-sub">Revisados e garantidos</div>
      </a>
    </div>
  </section>

  <!-- DESTAQUES -->
  {destaques.length > 0 && (
    <section class="jf-section">
      <div class="jf-section-head">
        <div>
          <div class="jf-eyebrow">Veículos em alta</div>
          <h2 class="jf-h2">Os mais procurados da semana</h2>
        </div>
        <Button href="/veiculos" variant="outline">Ver todos →</Button>
      </div>
      <div class="jf-g4">
        {destaques.map((v) => <VehicleCard vehicle={v} />)}
      </div>
    </section>
  )}

  <!-- VANTAGENS -->
  <section class="jf-section" aria-labelledby="vantagens-h">
    <h2 id="vantagens-h" class="jf-sr">Por que comprar na {site?.nomeSite ?? 'JF Veículos'}</h2>
    <div class="jf-g3 jf-vantagens">
      {vantagens.map((v) => (
        <div class="jf-vantagem">
          <div class="jf-vantagem-icon" aria-hidden="true"><Icon name={v.icon} size={23} color="var(--accent)" /></div>
          <div>
            <h3 class="jf-h3">{v.titulo}</h3>
            <p class="jf-p">{v.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- DEPOIMENTOS + INSTAGRAM -->
  <div class="jf-band">
    {depoimentos.length > 0 && (
      <section class="jf-section jf-band-depo">
        <h2 class="jf-h2 jf-center">Quem comprou, aprova</h2>
        {loja && (
          <p class="jf-rating">
            <span class="jf-rating-stars" aria-hidden="true">★★★★★</span> <strong>{loja.avaliacaoMedia.toLocaleString('pt-BR')}</strong> no Google · {loja.numAvaliacoes} avaliações
          </p>
        )}
        <div class="jf-g3">
          {depoimentos.map((d) => (
            <div class="jf-testimonial">
              <p class="jf-testimonial-text">"{d.data.texto}"</p>
              <div class="jf-testimonial-author">
                <div class="jf-testimonial-avatar" aria-hidden="true">{d.data.nome[0]}</div>
                <div>
                  <div class="jf-testimonial-name">{d.data.nome}</div>
                  <div class="jf-testimonial-local">{d.data.local}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- FAQ -->
  <section class="jf-faq">
    <h2 class="jf-h2 jf-center">Perguntas frequentes</h2>
    <div class="jf-faq-list">
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="jf-section jf-section-cta">
    <div class="jf-cta">
      <div>
        <h2 class="jf-cta-title">{site?.ctaFinalTitulo ?? 'Quer vender ou trocar o seu?'}</h2>
        <p class="jf-cta-sub">{site?.ctaFinalTexto ?? 'Avaliamos seu veículo na hora e você sai daqui com o próximo.'}</p>
      </div>
      <Button href={vendaHref} target="_blank" variant="white" data-wa-track="home_cta_final">{site?.ctaFinalBotao ?? 'Anunciar meu veículo'}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .jf-sr { position: absolute; left: -9999px; }
  .jf-center { text-align: center; }
  .jf-hero {
    background: radial-gradient(900px 520px at 85% 10%, rgba(200, 134, 43, .20), transparent 60%), var(--black-950);
    border-bottom: 1px solid var(--black-800);
  }
  .jf-hero-inner { max-width: 1240px; margin: 0 auto; padding: 72px 24px 64px; }
  .jf-hgrid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; }
  .jf-hero-copy { animation: jfrise .6s ease both; }
  .jf-sell-pill {
    display: inline-flex; align-items: center; flex-wrap: wrap; gap: 8px 14px; min-height: 56px; padding: 8px 8px 8px 22px; margin-bottom: 26px;
    border-radius: var(--radius-full); background: color-mix(in srgb, var(--accent) 16%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--white); font-size: 16px; font-weight: 600;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 8%, transparent);
    transition: background var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
  }
  .jf-sell-pill strong {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 18px; border-radius: var(--radius-full);
    background: var(--accent); color: var(--white); font-weight: 700; font-size: 15px;
  }
  .jf-sell-pill:hover { background: color-mix(in srgb, var(--accent) 26%, transparent); color: var(--white); transform: translateY(-1px); }
  .jf-sell-pill:hover strong { background: var(--accent-deep); }
  @media (max-width: 620px) { .jf-sell-pill { font-size: 15px; padding: 12px 12px 8px; border-radius: 24px; } }
  .jf-hero-title { font: 700 60px/1.04 var(--font-display); letter-spacing: -2px; margin: 0 0 18px; color: var(--white); }
  .jf-accent-text { color: var(--accent-on-dark); }
  .jf-hero-sub { font-size: 18px; line-height: 1.55; color: var(--text-on-dark-secondary); margin: 0; max-width: 520px; }
  .jf-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 32px; }
  .jf-hero-wa {
    display: inline-flex; align-items: center; gap: 12px; background: #25d366; color: #0b3d1f; border-radius: var(--radius-full);
    padding: 8px 24px 8px 8px; min-height: 56px; font-weight: 700; font-size: 16px;
  }
  .jf-hero-wa:hover { background: #1fb956; color: #0b3d1f; }
  .jf-hero-wa-ico { width: 40px; height: 40px; border-radius: 50%; background: var(--white); display: flex; align-items: center; justify-content: center; }
  .jf-hero-ghost {
    display: inline-flex; align-items: center; min-height: 56px; padding: 0 26px; border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, .3); color: var(--white); font-weight: 700; font-size: 15px;
  }
  .jf-hero-ig { width: 56px; height: 56px; padding: 0 !important; justify-content: center; }
  .jf-hero-ghost:hover { color: var(--white); border-color: rgba(255, 255, 255, .6); }
  .jf-trust { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 36px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, .12); }
  .jf-trust-n { font: 700 26px/1 var(--font-display); color: var(--white); }
  .jf-trust-l { font-size: 13px; color: var(--text-on-dark-secondary); margin-top: 6px; }

  .jf-feat { display: block; border-radius: 24px; background: rgba(255, 255, 255, .04); border: 1px solid rgba(255, 255, 255, .12); padding: 14px; box-shadow: 0 30px 80px rgba(0, 0, 0, .45); color: var(--white); }
  .jf-feat:hover { color: var(--white); }
  .jf-feat-photo {
    aspect-ratio: 4 / 3; border-radius: 16px; background: rgba(255, 255, 255, .08) center / cover; position: relative;
    display: flex; align-items: center; justify-content: center; font: 600 12px var(--font-display); letter-spacing: 2px; color: rgba(255, 255, 255, .6);
  }
  .jf-feat-badge { position: absolute; top: 14px; left: 14px; background: var(--accent-deep); color: var(--white); border-radius: var(--radius-full); padding: 6px 12px; font: 700 11.5px var(--font-body); letter-spacing: .4px; }
  .jf-feat-info { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 18px 8px 6px; }
  .jf-feat-meta { font-size: 12px; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; color: rgba(255, 255, 255, .6); }
  .jf-feat-name { font: 700 22px var(--font-display); margin-top: 4px; }
  .jf-feat-price { text-align: right; }
  .jf-feat-price > div { font: 700 24px var(--font-display); }
  .jf-feat-price small { font-size: 12.5px; color: rgba(255, 255, 255, .65); }

  .jf-quick {
    margin-top: 40px; background: var(--surface-card); border-radius: 20px; padding: 10px;
    display: grid; grid-template-columns: 1.3fr 1.1fr 1.1fr 1.4fr auto; gap: 8px;
    box-shadow: var(--shadow-raised); animation: jfrise .7s .1s ease both;
  }
  .jf-quick-field { display: flex; flex-direction: column; justify-content: center; gap: 0; padding: 4px 12px; }
  .jf-quick-sep { border-left: 1px solid var(--border-default); }
  .jf-quick-field label { font: var(--text-caption); color: var(--text-label); text-transform: uppercase; letter-spacing: .5px; }
  .jf-quick-field select, .jf-quick-field input {
    background: transparent; border: none; color: var(--text-primary); font-size: 15px; font-weight: 600; outline: none; cursor: pointer; min-height: 44px;
  }
  .jf-quick-field input { cursor: text; }
  .jf-quick-btn {
    border: none; background: var(--text-primary); color: var(--surface-card); font-weight: 700; font-size: 15px;
    border-radius: 12px; padding: 14px 28px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 9px;
    transition: opacity var(--dur-base) var(--ease-standard);
  }
  .jf-quick-btn:hover { opacity: .85; }

  .jf-msearch { display: none; margin-top: 28px; background: var(--surface-card); border-radius: 16px; padding: 6px; gap: 6px; align-items: center; }
  .jf-msearch input { flex: 1; min-width: 0; border: none; outline: none; padding: 12px; font-size: 15px; font-weight: 600; color: var(--text-primary); background: none; }
  .jf-msearch-filters {
    min-height: 44px; padding: 0 16px; border-radius: 12px; border: 1px solid var(--border-default); background: var(--surface-card);
    font-weight: 700; font-size: 14px; color: var(--text-primary); display: flex; align-items: center;
  }
  .jf-msearch-go { width: 44px; height: 44px; border-radius: 12px; border: none; background: var(--text-primary); color: var(--surface-card); display: flex; align-items: center; justify-content: center; cursor: pointer; }


  .jf-section { max-width: 1240px; margin: 0 auto; padding: 64px 24px 0; }
  .jf-section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24px; gap: 16px; flex-wrap: wrap; }
  .jf-eyebrow { font-size: 13px; font-weight: 700; color: var(--accent-strong); letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 8px; }
  .jf-h2 { font: 700 36px var(--font-display); letter-spacing: -1px; margin: 0; }
  .jf-h3 { font: 700 18px var(--font-display); margin: 4px 0 6px; }
  .jf-p { font: var(--text-body); color: var(--text-secondary); margin: 0; }

  .jf-g4, .jf-g3 { display: grid; gap: 18px; }
  .jf-g4 { grid-template-columns: repeat(4, 1fr); }
  .jf-g3 { grid-template-columns: repeat(3, 1fr); }

  .jf-cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; gap: 16px; }
  .jf-cat-card {
    display: block; border-radius: 20px; border: 1px solid var(--border-default); background: var(--surface-card);
    box-shadow: var(--shadow-card); padding: 20px; color: inherit;
    transition: box-shadow var(--dur-base) var(--ease-standard);
  }
  .jf-cat-card:hover { box-shadow: var(--shadow-raised); color: inherit; }
  .jf-cat-icon { width: 44px; height: 44px; border-radius: var(--radius-full); background: var(--surface-muted); display: flex; align-items: center; justify-content: center; }
  .jf-cat-title { font: 700 17px var(--font-display); margin-top: 14px; }
  .jf-cat-sub { font-size: 13px; color: var(--text-secondary); margin-top: 3px; }

  .jf-vantagens { border-radius: var(--radius-xl); border: 1px solid var(--border-default); background: var(--surface-card); box-shadow: var(--shadow-card); padding: 44px; }
  .jf-vantagem { display: flex; gap: 16px; align-items: flex-start; }
  .jf-vantagem-icon { width: 52px; height: 52px; border-radius: 12px; background: var(--surface-muted); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

  .jf-band { background: var(--surface-band); border-top: 1px solid var(--border-default); border-bottom: 1px solid var(--border-default); margin-top: 64px; }
  .jf-band-depo { padding-bottom: 48px; }
  .jf-rating { text-align: center; margin: 10px 0 30px; font-size: 14px; color: var(--text-secondary); }
  .jf-rating-stars { color: var(--accent-strong); }
  .jf-rating strong { color: var(--text-primary); }
  .jf-testimonial { background: var(--surface-card); border: 1px solid var(--border-default); border-radius: 20px; box-shadow: var(--shadow-card); padding: 26px; display: flex; flex-direction: column; height: 100%; }
  .jf-testimonial-text { font: var(--text-body); color: var(--text-secondary); line-height: 1.7; margin: 0 0 20px; }
  .jf-testimonial-author { display: flex; align-items: center; gap: 12px; margin-top: auto; }
  .jf-testimonial-avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--surface-muted); display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--text-secondary); }
  .jf-testimonial-name { font-weight: 700; font-size: 14.5px; }
  .jf-testimonial-local { font-size: 12.5px; color: var(--text-secondary); }

  .jf-section-cta { padding-top: 40px; padding-bottom: 20px; }
  .jf-cta {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding: 46px;
    border-radius: var(--radius-xl); background: linear-gradient(120deg, var(--accent), var(--accent-deep));
